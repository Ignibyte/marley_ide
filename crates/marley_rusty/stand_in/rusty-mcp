def capture_line(text, target, day):
    """Rusty's `brain_capture`: the line as a timeline entry of the daily note or the inbox, the
    page made first when missing (#663)."""
    text = str(text or "").strip()
    if not text:
        raise Refused("Nothing to capture")
    target = str(target or "daily")
    if target not in ("daily", "inbox"):
        raise Refused(f"Unknown capture target: {target} (use daily or inbox)")
    day = str(day or "").strip() or today_in_state().isoformat()
    if not is_iso_date(day):
        raise Refused(f"Invalid date: {day} (use YYYY-MM-DD)")
    slug = f"daily/{day}" if target == "daily" else "inbox/inbox"
    path = in_vault(slug + ".md")
    created = not os.path.isfile(path)
