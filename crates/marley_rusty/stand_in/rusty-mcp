    "skill_list": lambda arguments: skill_list(bool(arguments.get("include_pending"))),
    "skill_view": lambda arguments: find_skill(arguments.get("name"))
    or refuse(f"no skill named {arguments.get('name')}"),
    "skill_create": lambda arguments: skill_create(
