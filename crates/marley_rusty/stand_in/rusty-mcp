SECRET_MARKERS = ["ghp_", "github_pat_", "gho_", "glpat-", "AKIA", "xoxb-", "xoxp-", "-----BEGIN"]


def skills_base(status):
    return os.path.join(SKILLS, ".claude", "skills") if status == "active" else os.path.join(SKILLS, "staging")


def valid_skill_name(name):
    """Rusty's rule: lowercase letters, digits and hyphens, no hyphen at either end."""
    return bool(name) and not name.startswith("-") and not name.endswith("-") and all(
        char.islower() and char.isascii() or char.isdigit() or char == "-" for char in name
    )


def split_skill(raw):
    """A SKILL.md's frontmatter lines and its body."""
    lines = raw.split("\n")
    if lines and lines[0].strip() == "---":
        for at in range(1, len(lines)):
            if lines[at].strip() == "---":
                return lines[1:at], "\n".join(lines[at + 1 :]).lstrip("\n")
    return [], raw


def frontmatter_value(lines, key):
    for line in lines:
        if line.split(":", 1)[0].strip() == key and ":" in line:
            return scalar(line.split(":", 1)[1])
    return None


def read_skill(name, status):
    path = os.path.join(skills_base(status), name, "SKILL.md")
    with open(path, encoding="utf-8") as stored:
        lines, body = split_skill(stored.read())
    return {
        "name": name,
        "display_name": frontmatter_value(lines, "name") or name,
        "description": frontmatter_value(lines, "description") or "",
        "origin": "auto" if frontmatter_value(lines, "rusty_origin") == "auto" else "user",
        "status": status,
        "path": path,
        "body": body,
    }


def skill_list(include_pending):
    """Rusty's `skill_list`: the active skills, and the staged ones when asked, by name."""
    found = []
    for status in ("active", "pending") if include_pending else ("active",):
        base = skills_base(status)
        if os.path.isdir(base):
            found += [
                read_skill(name, status)
                for name in os.listdir(base)
                if os.path.isfile(os.path.join(base, name, "SKILL.md"))
            ]
    return sorted(found, key=lambda skill: skill["name"])


def find_skill(name):
    for status in ("active", "pending"):
        if os.path.isfile(os.path.join(skills_base(status), str(name), "SKILL.md")):
            return read_skill(name, status)
    return None


def scan_skill(raw):
    """Rusty's `scan_skill_md`: too long, `allowed-tools`, a bang-backtick, a secret's marker."""
    findings = []
    lines = raw.count("\n") + (0 if raw.endswith("\n") else 1)
    if lines > 200:
        findings.append(f"oversized: {lines} lines (> 200)")
    front, _ = split_skill(raw)
    if any(line.split(":", 1)[0].strip() in ("allowed-tools", "allowed_tools") for line in front):
        findings.append("declares allowed-tools (pre-approves tools without prompting)")
    if "!`" in raw or "```!" in raw:
        findings.append("contains a dynamic command-injection marker (bang-backtick)")
    findings += [f"possible secret marker: {marker}" for marker in SECRET_MARKERS if marker in raw]
    return findings


def skill_text(name, description, body, auto):
    head = f"---\nname: {name}\ndescription: {json.dumps(description)}\n"
    if auto:
        head += "rusty_origin: auto\n"
    return head + "---\n" + body


def skill_create(name, description, body, pending, force):
    name = str(name or "")
    if not valid_skill_name(name):
        raise Refused(f'invalid skill name "{name}": use lowercase letters, digits, and hyphens')
    status = "pending" if pending else "active"
    path = os.path.join(skills_base(status), name, "SKILL.md")
    if os.path.exists(path) and not (force or pending):
        raise Refused(f'skill "{name}" already exists (use --force to overwrite)')
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as stored:
        stored.write(skill_text(name, str(description or ""), str(body or ""), bool(pending)))
    return read_skill(name, status)


def skill_update(name, description, body):
    """Rusty's `skill_update`: the description and body rewritten, other keys kept; the skill as
    reread, and the new file's scan."""
    skill = find_skill(name)
    if skill is None:
        raise Refused(f'skill "{name}" not found')
    with open(skill["path"], encoding="utf-8") as stored:
        front, old_body = split_skill(stored.read())
    if description is not None:
        front = [line for line in front if line.split(":", 1)[0].strip() != "description"]
        front.insert(1 if front and front[0].startswith("name:") else 0, f"description: {json.dumps(description)}")
    raw = "---\n" + "\n".join(front) + "\n---\n" + (old_body if body is None else body)
    with open(skill["path"], "w", encoding="utf-8") as stored:
        stored.write(raw)
    return {"skill": read_skill(name, skill["status"]), "findings": scan_skill(raw)}


def skill_delete(name):
    skill = find_skill(name)
    if skill is None:
        raise Refused(f'skill "{name}" not found')
    shutil.rmtree(os.path.dirname(skill["path"]))
    return "deleted"


def skill_scan(name):
    skill = find_skill(name)
    if skill is None:
        raise Refused(f'skill "{name}" not found')
    with open(skill["path"], encoding="utf-8") as stored:
        return scan_skill(stored.read())


def skill_approve(name, force):
    """Rusty's `skill_approve`: a staged skill made active, refused while its scan has findings
    unless forced."""
    name = str(name or "")
    if not valid_skill_name(name):
        raise Refused(f'invalid skill name "{name}"')
    source = os.path.join(skills_base("pending"), name)
    if not os.path.isfile(os.path.join(source, "SKILL.md")):
        raise Refused(f'no pending skill "{name}" to approve')
    target = os.path.join(skills_base("active"), name)
    if os.path.exists(target):
        raise Refused(f'an active skill "{name}" already exists')
    with open(os.path.join(source, "SKILL.md"), encoding="utf-8") as stored:
        findings = scan_skill(stored.read())
    if findings and not force:
        raise Refused(
            f"blocked by safety scan ({len(findings)} issue(s)): {'; '.join(findings)}"
            " — re-run with --force to override"
        )
    os.makedirs(os.path.dirname(target), exist_ok=True)
    shutil.move(source, target)
    return "approved"


def skill_reject(name):
    name = str(name or "")
    source = os.path.join(skills_base("pending"), name)
    if not valid_skill_name(name) or not os.path.isfile(os.path.join(source, "SKILL.md")):
        raise Refused(f'no pending skill "{name}" to reject')
    shutil.rmtree(source)
    return "rejected"


def script_list(include_pending):
    """Rusty's `script_list`: each `*.sh` beside a skill, by name then skill."""
    found = []
    for status in ("active", "pending") if include_pending else ("active",):
        base = skills_base(status)
        if not os.path.isdir(base):
            continue
        for skill in os.listdir(base):
            folder = os.path.join(base, skill)
            if not os.path.isdir(folder):
                continue
            for name in os.listdir(folder):
                if name.endswith(".sh"):
                    path = os.path.join(folder, name)
                    found.append({
                        "name": name[:-3],
                        "skill": skill,
                        "path": path,
                        "status": status,
                        "executable": os.access(path, os.X_OK),
                    })
    return sorted(found, key=lambda script: (script["name"], script["skill"]))


def find_script(name):
    name = str(name or "").strip()
    name = name[:-3] if name.endswith(".sh") else name
    skill, _, base = name.rpartition("/")
    found = [
        script for script in script_list(True)
        if script["name"] == base and (not skill or script["skill"] == skill)
    ]
    if not found:
        raise Refused(f"no script named {name}")
    return found[0]


def script_view(name):
    script = find_script(name)
    with open(script["path"], encoding="utf-8") as stored:
        return {"script": script, "text": stored.read()}


def script_update(name, body):
    script = find_script(name)
    with open(script["path"], "w", encoding="utf-8") as stored:
        stored.write(str(body or ""))
    return script


WIKILINK = re.compile(r"(!?)\[\[([^\]|]*)(?:\|[^\]]*)?\]\]")


def scalar(text):
    """A YAML scalar as Rusty's frontmatter parser reads the simple ones."""
    text = text.strip()
    if len(text) >= 2 and text[0] == text[-1] and text[0] in "'\"":
        return text[1:-1]
    if text in ("true", "false"):
        return text == "true"
    if text in ("", "null", "~"):
        return None
    for kind in (int, float):
        try:
            return kind(text)
        except ValueError:
            pass
    return text


def frontmatter(raw):
    """The frontmatter's keys in file order, and the body: scalars, `[a, b]` lists and block lists."""
    lines = raw.split("\n")
    if not lines or lines[0].strip() != "---":
        return [], raw
    properties, key = [], None
    for at, line in enumerate(lines[1:], start=1):
        if line.strip() == "---":
            return properties, "\n".join(lines[at + 1 :])
        if line.startswith(("  - ", "- ")) and key is not None:
            value = properties[-1][1]
            properties[-1] = (key, (value if isinstance(value, list) else []) + [scalar(line.split("- ", 1)[1])])
        elif ":" in line and not line.startswith(" "):
            key, value = line.split(":", 1)
            key, value = key.strip(), value.strip()
            if value.startswith("[") and value.endswith("]"):
                properties.append((key, [scalar(part) for part in value[1:-1].split(",") if part.strip()]))
            else:
                properties.append((key, scalar(value)))
    return [], raw


def resolve(target):
    """The slug `target` names: its own path, else the one page with that name."""
    if not target:
        return None
    if os.path.isfile(in_vault(target + ".md")):
        return target
    named = [slug for slug, _, _ in pages() if slug.rsplit("/", 1)[-1] == target]
    return named[0] if len(named) == 1 else None


def target_of(destination):
    target = destination
    for cut in "#^":
        target = target.split(cut, 1)[0]
    target = target.strip().lstrip("/")
    target = target[2:] if target.startswith("./") else target
    return target[:-3] if target.endswith(".md") else target


INLINE_TAG = re.compile(r"(?<![\w/#&])#([A-Za-z][\w/-]*)")


def page_tags(raw):
    """The page's tags as Rusty's index holds them: the frontmatter's, then inline `#tags`."""
    properties, body = frontmatter(raw)
    value = dict(properties).get("tags")
    tags = [str(tag) for tag in value] if isinstance(value, list) else [str(value)] if value else []
    for line in body.split("\n"):
        tags += INLINE_TAG.findall(line)
    unique = []
    for tag in tags:
        if tag not in unique:
            unique.append(tag)
    return unique


def links(slug):
    """`brain_get_links`: the page's links in order, one per target, and the links to it."""
    slug = clean(slug)
    outbound, backlinks = [], []
    path = in_vault(slug + ".md")
    if os.path.isfile(path):
        with open(path, encoding="utf-8") as page:
            body = frontmatter(page.read())[1]
        seen = set()
        for line in body.split("\n"):
            for found in WIKILINK.finditer(line):
                target = target_of(found.group(2))
                if target in seen:
                    continue
                seen.add(target)
                resolved = slug if not target else resolve(target)
                outbound.append(
                    {
                        "from_slug": slug,
                        "to_slug": resolved or target,
                        "link_type": "wikilink",
                        "context": line.strip(),
                        "resolved": resolved is not None,
                    }
                )
    for other, _, text in pages():
        if other == slug:
            continue
        line = next(
            (
                line
                for line in frontmatter(text)[1].split("\n")
                if any(
                    target_of(found.group(2)) and resolve(target_of(found.group(2))) == slug
                    for found in WIKILINK.finditer(line)
                )
            ),
            None,
        )
        if line is not None:
            backlinks.append(
                {
                    "from_slug": other,
                    "to_slug": slug,
                    "link_type": "wikilink",
                    "context": line.strip(),
                    "resolved": True,
                }
            )
    return {"outbound": outbound, "backlinks": sorted(backlinks, key=lambda link: link["from_slug"])}


# Rusty's page types and their folders, in the order `brain_page_types` gives them.
TYPE_DIRS = [
    ("person", "people"),
    ("company", "companies"),
    ("project", "projects"),
    ("concept", "concepts"),
    ("meeting", "meetings"),
    ("idea", "ideas"),
    ("daily", "daily"),
    ("inbox", "inbox"),
    ("decision", "decisions"),
    ("conversation", "conversations"),
    ("source", "sources"),
]


def page_type(slug, properties):
    """Rusty's rule: the frontmatter's `type`, else the type its top folder names, else `note`."""
    stated = dict(properties).get("type")
    if stated:
        return str(stated)
    top = slug.split("/", 1)[0] if "/" in slug else ""
    return next((kind for kind, folder in TYPE_DIRS if folder == top), "note")


def as_list(value):
    if isinstance(value, list):
        return [str(each) for each in value if each is not None]
    return [str(value)] if value else []


def graph(arguments):
    """`brain_graph` as Rusty answers it: every page; a decision's typed edges first, so they win
    over the plain link between the same two pages; the resolved links; unresolved targets and
    tags as nodes on request; and with `around`, that page's neighbourhood `depth` edges out,
    breadth first over every edge. Pages are indexed once, so a vault of thousands answers in a
    moment."""
    found = pages()
    known = {slug for slug, _, _ in found}
    names = {}
    for slug, _, _ in found:
        names.setdefault(slug.rsplit("/", 1)[-1], []).append(slug)

    def resolved(target):
        if not target:
            return None
        if target in known:
            return target
        named = names.get(target, [])
        return named[0] if len(named) == 1 else None

    nodes, edges, seen, ids, parsed = [], [], set(), set(known), []
    for slug, title, text in found:
        properties, body = frontmatter(text)
        kind = page_type(slug, properties)
        parsed.append((slug, kind, dict(properties), body, page_tags(text)))
        nodes.append(
            {
                "id": slug,
                "kind": "page",
                "title": title,
                "page_type": kind,
                "folder": slug.rsplit("/", 1)[0] if "/" in slug else "",
                "tags": parsed[-1][4],
            }
        )

    def edge(source, target, kind):
        if (source, target) not in seen:
            seen.add((source, target))
            edges.append({"from": source, "to": target, "kind": kind})

    for slug, kind, properties, _, _ in parsed:
        if kind != "decision":
            continue
        typed = [(target, "consulted") for target in as_list(properties.get("consulted"))]
        typed += [(target, "supersedes") for target in as_list(properties.get("supersedes"))[:1]]
        typed += [(target, "follows_up") for target in as_list(properties.get("superseded_by"))[:1]]
        for target, name in typed:
            if target in known:
                edge(slug, target, name)
    for slug, _, _, body, _ in parsed:
        for hit in WIKILINK.finditer(body):
            target = target_of(hit.group(2))
            to = resolved(target)
            if to and to != slug:
                edge(slug, to, "link")
            elif to is None and target and arguments.get("unresolved"):
                node = "new:" + target
                if node not in ids:
                    ids.add(node)
                    nodes.append(
                        {"id": node, "kind": "unresolved", "title": target, "page_type": "", "folder": "", "tags": []}
                    )
                edge(slug, node, "link")
    if arguments.get("tags"):
        for slug, _, _, _, tags in parsed:
            for tag in tags:
                node = "tag:" + tag.lower()
                if node not in ids:
                    ids.add(node)
                    nodes.append(
                        {"id": node, "kind": "tag", "title": "#" + tag, "page_type": "", "folder": "", "tags": []}
                    )
                edge(slug, node, "link")
    around = clean(str(arguments.get("around") or "").strip())
    if not around:
        return {"nodes": nodes, "edges": edges}
    adjacent = {}
    for each in edges:
        adjacent.setdefault(each["from"], []).append(each["to"])
        adjacent.setdefault(each["to"], []).append(each["from"])
    keep, queue = set(), []
    if around in ids:
        keep, queue = {around}, [(around, 0)]
    depth = max(1, int(arguments.get("depth") or 1))
    while queue:
        node, far = queue.pop(0)
        if far >= depth:
            continue
        for other in adjacent.get(node, []):
            if other not in keep:
                keep.add(other)
                queue.append((other, far + 1))
    return {
        "nodes": [node for node in nodes if node["id"] in keep],
        "edges": [each for each in edges if each["from"] in keep and each["to"] in keep],
    }


def page_types():
    """`brain_page_types`: Rusty's types in order, each with its folder and page count."""
    counts = {}
    for slug, _, text in pages():
        kind = page_type(slug, frontmatter(text)[0])
        counts[kind] = counts.get(kind, 0) + 1
    return [{"page_type": kind, "dir": folder, "count": counts.get(kind, 0)} for kind, folder in TYPE_DIRS]


def tag_counts():
    """`brain_tags`: each tag, and each ancestor of a nested one, with its page count."""
    counts = {}
    for _, _, text in pages():
        carried = set()
        for tag in page_tags(text):
            parts = tag.split("/")
            carried |= {"/".join(parts[: at + 1]) for at in range(len(parts))}
        for tag in carried:
            counts[tag] = counts.get(tag, 0) + 1
    return [{"tag": tag, "count": counts[tag]} for tag in sorted(counts, key=str.lower)]


def outline(body):
    """Rusty's outline: each ATX heading outside a fence, its level, its text as written and its
    line in the body from 0."""
    headings, fence = [], False
    for at, line in enumerate(body.split("\n")):
        stripped = line.lstrip()
        if stripped.startswith(("```", "~~~")):
            fence = not fence
            continue
        if fence:
            continue
        hashes = len(stripped) - len(stripped.lstrip("#"))
        rest = stripped[hashes:]
        if 1 <= hashes <= 6 and rest[:1] in (" ", "\t"):
            text = rest.strip().rstrip("#").strip()
            if text:
                headings.append({"level": hashes, "text": text, "line": at})
    return headings


def render(slug):
    slug = clean(slug)
    path = in_vault(slug + ".md")
    if not os.path.isfile(path):
        return None
    with open(path, encoding="utf-8") as page:
        raw = page.read()
    properties, body = frontmatter(raw)
    values = dict(properties)
    links, unresolved = [], []
    for embed, destination in ((m.group(1), m.group(2)) for m in WIKILINK.finditer(body)):
        target = destination
        for cut in "#^":
            target = target.split(cut, 1)[0]
        target = target.strip().lstrip("/")
        target = target[2:] if target.startswith("./") else target
        target = target[:-3] if target.endswith(".md") else target
        resolved = slug if not target else resolve(target)
        links.append({"target": target, "slug": resolved, "alias": None, "embed": bool(embed)})
        if resolved is None and target not in unresolved:
            unresolved.append(target)
    return {
        "slug": slug,
        "title": str(values.get("title") or slug.rsplit("/", 1)[-1]),
        "page_type": str(values.get("type") or slug.split("/", 1)[0]),
        "properties": [{"key": key, "value": value} for key, value in properties],
        "raw": raw,
        "file": os.path.abspath(path),
        "html": "",
        "outline": outline(body),
        "links": links,
        "unresolved": unresolved,
        "tasks": 0,
        "words": len(body.split()),
        "characters": len(body),
    }


