#!/usr/bin/env python3
"""A stand-in for Rusty's MCP server, `rusty-mcp`, for Marley's e2e scenarios (#643 to #646).

It answers the tools Marley reads as `rusty-mcp` does (each answer JSON text in a text block, a
refusal a JSON-RPC error carrying Rusty's message), from `../fixtures/settings_list.json` and a
scratch vault, over a scratch state folder, `$RUSTY_STAND_IN_STATE`, and never reaches a real
Rusty. The vault is `$RUSTY_STAND_IN_STATE/vault`, made with `archive/` as Rusty makes its vault,
and stored as `brain_vault_path`; as Rusty does since its TICKET-040, the root's `archive/` is left
out of the tree and the search, and nothing is written into it but a delete. With no arguments it speaks MCP on stdio; with `--http ADDR` it
serves Streamable HTTP's POST and DELETE on ADDR (port 0 picks one, written to
`$RUSTY_STAND_IN_STATE/http-addr`). Every request goes to `$RUSTY_STAND_IN_STATE/calls` with this
process's id. On stdio it sends `notifications/resources/list_changed` when its settings file or a
file in its vault changes, its own writes included, as `rusty-mcp` announces each change its
watcher sees. Links are not rewritten on a rename, search matches words, not embeddings, and
`brain_render` gives no HTML: Marley reads `raw`, `properties`, `file` and `links`.
"""

import json
import os
import re
import shutil
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

HERE = os.path.dirname(os.path.realpath(__file__))
FIXTURE = os.path.join(HERE, "..", "fixtures", "settings_list.json")
STATE = os.environ.get("RUSTY_STAND_IN_STATE") or os.path.join(os.getcwd(), "rusty-stand-in")
SETTINGS = os.path.join(STATE, "settings.json")
CALLS = os.path.join(STATE, "calls")
VAULT = os.path.join(STATE, "vault")
LOCK = threading.Lock()

TOOL_NAMES = [
    "settings_list",
    "setting_get",
    "setting_set",
    "brain_tree",
    "brain_search",
    "brain_daily_note",
    "brain_new_page",
    "brain_new_folder",
    "brain_rename",
    "brain_delete_page",
    "brain_delete_folder",
    "brain_render",
    "brain_get_links",
    "brain_graph",
    "brain_tags",
    "brain_ask",
    "brain_decide",
    "brain_no_decision",
    "brain_follow_up",
]


def log(line):
    with LOCK, open(CALLS, "a", encoding="utf-8") as calls:
        calls.write(f"{os.getpid()} {line}\n")


def load():
    with open(SETTINGS, encoding="utf-8") as stored:
        return json.load(stored)


def save(settings):
    with LOCK:
        with open(SETTINGS + ".new", "w", encoding="utf-8") as stored:
            json.dump(settings, stored, indent=2, sort_keys=True)
        os.replace(SETTINGS + ".new", SETTINGS)


def seed():
    os.makedirs(STATE, exist_ok=True)
    os.makedirs(os.path.join(VAULT, "archive"), exist_ok=True)
    if os.path.exists(SETTINGS):
        settings = load()
    else:
        with open(FIXTURE, encoding="utf-8") as fixture:
            settings = {entry["key"]: entry["value"] for entry in json.load(fixture)}
    if "brain_vault_path" not in settings:
        settings["brain_vault_path"] = VAULT
        save(settings)
    elif not os.path.exists(SETTINGS):
        save(settings)


class Refused(Exception):
    """A tool's refusal, worded as Rusty words it."""


def clean(path):
    return "/".join(part for part in str(path).strip().split("/") if part and part != ".")


def in_vault(rel):
    if ".." in rel.split("/"):
        raise Refused("Invalid path: path traversal not allowed")
    return os.path.join(VAULT, rel) if rel else VAULT


def refuse_archive(rel):
    if rel == "archive" or rel.startswith("archive/"):
        raise Refused(
            "archive/ holds deleted pages; delete a page to archive it, or move one out to restore it"
        )


def tree():
    def node(name, rel, directory):
        folders, files = [], []
        for entry in os.listdir(directory):
            if entry.startswith(".") or (not rel and entry == "archive"):
                continue
            path = os.path.join(directory, entry)
            child = f"{rel}/{entry}" if rel else entry
            if os.path.isdir(path):
                folders.append(node(entry, child, path))
            elif os.path.isfile(path):
                page = entry.endswith(".md")
                files.append(
                    {
                        "name": entry[:-3] if page else entry,
                        "path": child[:-3] if page else child,
                        "kind": "page" if page else "file",
                        "pages": int(page),
                        "children": [],
                    }
                )
        folders.sort(key=lambda found: found["name"].lower())
        files.sort(key=lambda found: found["name"].lower())
        children = folders + files
        return {
            "name": name,
            "path": rel,
            "kind": "folder",
            "pages": sum(child["pages"] for child in children),
            "children": children,
        }

    return node(os.path.basename(VAULT), "", VAULT)


def pages():
    """Every page outside `archive/`, as (slug, title, text)."""
    found = []
    for directory, folders, files in os.walk(VAULT):
        folders[:] = [folder for folder in folders if not folder.startswith(".")]
        rel = os.path.relpath(directory, VAULT)
        if rel == "archive" or rel.startswith("archive/"):
            continue
        for name in files:
            if not name.endswith(".md"):
                continue
            slug = clean(os.path.join(rel, name[:-3]))
            with open(os.path.join(directory, name), encoding="utf-8") as page:
                text = page.read()
            title = next(
                (line[6:].strip() for line in text.splitlines() if line.startswith("title:")),
                name[:-3],
            )
            found.append((slug, title, text))
    return sorted(found)


def flat(text):
    """Line breaks and runs of space as one space, the ends kept, as Rusty's `snippet_around`."""
    return re.sub(r"\s+", " ", text)


def search(query, limit, case_sensitive=False, regex=False):
    """Pages matching `query`: its `tag:` terms by the page's tags, the rest as one phrase (or a
    regular expression), each hit's snippet with the match between `<b>` and `</b>`; a query of
    `tag:` terms alone answers no snippet, as Rusty does."""
    terms = query.split()
    tags = [term[4:].lower() for term in terms if term.startswith("tag:")]
    phrase = " ".join(term for term in terms if not term.startswith("tag:"))
    hits = []
    for slug, title, text in pages():
        carried = [tag.lower() for tag in page_tags(text)]
        if not all(any(have == tag or have.startswith(tag + "/") for have in carried) for tag in tags):
            continue
        hit = {"slug": slug, "page_type": "note", "title": title, "snippet": "", "rank": 1.0}
        if not phrase:
            if tags:
                hits.append(hit)
            continue
        haystack = f"{title}\n{frontmatter(text)[1]}"
        flags = 0 if case_sensitive else re.IGNORECASE
        pattern = phrase if regex else re.escape(phrase)
        try:
            found = re.search(pattern, haystack, flags)
        except re.error as error:
            raise Refused(f"Invalid regex: {error}")
        if not found:
            continue
        start, end = found.span()
        hit["snippet"] = (
            flat(haystack[max(0, start - 40) : start])
            + "<b>"
            + flat(haystack[start:end])
            + "</b>"
            + flat(haystack[end : end + 60])
        ).strip()
        hits.append(hit)
    return hits[: limit or 10]


def write_page(slug, title):
    path = in_vault(slug + ".md")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as page:
        page.write(f"---\ntitle: {title}\n---\n")


def new_page(folder, name, path=None):
    if path and path.strip():
        # Rusty's TICKET-041: the page at exactly that path, folders made, an existing one as it is.
        slug = clean(path[:-3] if path.endswith(".md") else path)
        refuse_archive(slug)
        if not os.path.isfile(in_vault(slug + ".md")):
            write_page(slug, slug.rsplit("/", 1)[-1])
        return slug
    folder = clean(folder)
    refuse_archive(folder)
    if folder and not os.path.isdir(in_vault(folder)):
        raise Refused(f"No folder {folder}")
    base = (name or "").strip()
    base = base[:-3] if base.endswith(".md") else base
    base = base.replace("/", "-") or "Untitled"
    prefix = f"{folder}/" if folder else ""
    candidate, number = base, 1
    while os.path.exists(in_vault(f"{prefix}{candidate}.md")):
        candidate, number = f"{base} {number}", number + 1
    write_page(prefix + candidate, candidate)
    return prefix + candidate


def new_folder(path):
    path = clean(path)
    if not path:
        raise Refused("A folder needs a name")
    refuse_archive(path)
    if os.path.exists(in_vault(path)):
        raise Refused(f"Already exists: {path}")
    os.makedirs(in_vault(path))
    return path


def rename(source, target):
    source = clean(source[:-3] if source.endswith(".md") else source)
    into_folder = target.strip().endswith("/")
    target = clean(target[:-3] if target.endswith(".md") else target)
    if into_folder:
        name = source.rsplit("/", 1)[-1]
        target = f"{target}/{name}" if target else name
    if not target:
        raise Refused("A name is needed")
    refuse_archive(target)
    if os.path.isfile(in_vault(source + ".md")):
        if source != target:
            if os.path.exists(in_vault(target + ".md")):
                raise Refused(f"Already exists: {target}")
            os.makedirs(os.path.dirname(in_vault(target + ".md")), exist_ok=True)
            os.rename(in_vault(source + ".md"), in_vault(target + ".md"))
        kind = "page"
    elif os.path.isdir(in_vault(source)) and source:
        if target == source or target.startswith(source + "/"):
            raise Refused("Cannot move a folder into itself")
        if os.path.exists(in_vault(target)):
            raise Refused(f"Already exists: {target}")
        os.makedirs(os.path.dirname(in_vault(target)), exist_ok=True)
        os.rename(in_vault(source), in_vault(target))
        kind = "folder"
    else:
        raise Refused(f"Not found: {source}")
    return {"from": source, "to": target, "kind": kind, "pages_rewritten": 0}


def archive(path):
    name = f"{os.path.basename(path)}_{int(time.time())}"
    shutil.move(path, os.path.join(VAULT, "archive", name))
    return f"archive/{name}"


def delete_page(slug):
    slug = clean(slug)
    path = in_vault(slug + ".md")
    if not os.path.isfile(path):
        raise Refused(f"Page not found: {slug}")
    archive(path)
    return "deleted"


def delete_folder(folder):
    folder = clean(folder)
    if not folder:
        raise Refused("Refusing to delete the vault root")
    if not os.path.isdir(in_vault(folder)):
        raise Refused(f"Folder not found: {folder}")
    return archive(in_vault(folder))


def daily_note(date):
    date = date or time.strftime("%Y-%m-%d")
    slug = f"daily/{date}"
    if not os.path.exists(in_vault(slug + ".md")):
        write_page(slug, date)
    return {
        "slug": slug,
        "page_type": "daily",
        "title": date,
        "compiled_truth": "",
        "timeline": "",
        "frontmatter": {"title": date, "type": "daily"},
        "content_hash": "",
        "created_at": 0,
        "updated_at": 0,
    }


WIKILINK = re.compile(r"(!?)\[\[([^\]|]*)(?:\|[^\]]*)?\]\]")


def scalar(text):
    """A YAML scalar as Rusty's frontmatter parser reads the simple ones."""
    text = text.strip()
    if len(text) >= 2 and text[0] == text[-1] and text[0] in "'\"":
        return text[1:-1]
    if text in ("true", "false"):
        return text == "true"
    if text in ("", "null", "~"):
        return None
    for kind in (int, float):
        try:
            return kind(text)
        except ValueError:
            pass
    return text


def frontmatter(raw):
    """The frontmatter's keys in file order, and the body: scalars, `[a, b]` lists and block lists."""
    lines = raw.split("\n")
    if not lines or lines[0].strip() != "---":
        return [], raw
    properties, key = [], None
    for at, line in enumerate(lines[1:], start=1):
        if line.strip() == "---":
            return properties, "\n".join(lines[at + 1 :])
        if line.startswith(("  - ", "- ")) and key is not None:
            value = properties[-1][1]
            properties[-1] = (key, (value if isinstance(value, list) else []) + [scalar(line.split("- ", 1)[1])])
        elif ":" in line and not line.startswith(" "):
            key, value = line.split(":", 1)
            key, value = key.strip(), value.strip()
            if value.startswith("[") and value.endswith("]"):
                properties.append((key, [scalar(part) for part in value[1:-1].split(",") if part.strip()]))
            else:
                properties.append((key, scalar(value)))
    return [], raw


def resolve(target):
    """The slug `target` names: its own path, else the one page with that name."""
    if not target:
        return None
    if os.path.isfile(in_vault(target + ".md")):
        return target
    named = [slug for slug, _, _ in pages() if slug.rsplit("/", 1)[-1] == target]
    return named[0] if len(named) == 1 else None


def target_of(destination):
    target = destination
    for cut in "#^":
        target = target.split(cut, 1)[0]
    target = target.strip().lstrip("/")
    target = target[2:] if target.startswith("./") else target
    return target[:-3] if target.endswith(".md") else target


INLINE_TAG = re.compile(r"(?<![\w/#&])#([A-Za-z][\w/-]*)")


def page_tags(raw):
    """The page's tags as Rusty's index holds them: the frontmatter's, then inline `#tags`."""
    properties, body = frontmatter(raw)
    value = dict(properties).get("tags")
    tags = [str(tag) for tag in value] if isinstance(value, list) else [str(value)] if value else []
    for line in body.split("\n"):
        tags += INLINE_TAG.findall(line)
    unique = []
    for tag in tags:
        if tag not in unique:
            unique.append(tag)
    return unique


def links(slug):
    """`brain_get_links`: the page's links in order, one per target, and the links to it."""
    slug = clean(slug)
    outbound, backlinks = [], []
    path = in_vault(slug + ".md")
    if os.path.isfile(path):
        with open(path, encoding="utf-8") as page:
            body = frontmatter(page.read())[1]
        seen = set()
        for line in body.split("\n"):
            for found in WIKILINK.finditer(line):
                target = target_of(found.group(2))
                if target in seen:
                    continue
                seen.add(target)
                resolved = slug if not target else resolve(target)
                outbound.append(
                    {
                        "from_slug": slug,
                        "to_slug": resolved or target,
                        "link_type": "wikilink",
                        "context": line.strip(),
                        "resolved": resolved is not None,
                    }
                )
    for other, _, text in pages():
        if other == slug:
            continue
        line = next(
            (
                line
                for line in frontmatter(text)[1].split("\n")
                if any(
                    target_of(found.group(2)) and resolve(target_of(found.group(2))) == slug
                    for found in WIKILINK.finditer(line)
                )
            ),
            None,
        )
        if line is not None:
            backlinks.append(
                {
                    "from_slug": other,
                    "to_slug": slug,
                    "link_type": "wikilink",
                    "context": line.strip(),
                    "resolved": True,
                }
            )
    return {"outbound": outbound, "backlinks": sorted(backlinks, key=lambda link: link["from_slug"])}


def graph(around, depth):
    """`brain_graph`'s pages and links, or the neighbourhood of `around`, `depth` links out."""
    found = pages()
    nodes = {
        slug: {
            "id": slug,
            "kind": "page",
            "title": title,
            "page_type": slug.split("/", 1)[0] if "/" in slug else "",
            "folder": slug.rsplit("/", 1)[0] if "/" in slug else "",
            "tags": page_tags(text),
        }
        for slug, title, text in found
    }
    edges = []
    for slug, _, text in found:
        for hit in WIKILINK.finditer(frontmatter(text)[1]):
            target = resolve(target_of(hit.group(2)))
            if target and target != slug and {"from": slug, "to": target, "kind": "link"} not in edges:
                edges.append({"from": slug, "to": target, "kind": "link"})
    if around:
        around = clean(around)
        if around not in nodes:
            return {"nodes": [], "edges": []}
        kept, frontier = {around}, {around}
        for _ in range(max(1, depth or 1)):
            frontier = {
                edge["to"] if edge["from"] in frontier else edge["from"]
                for edge in edges
                if edge["from"] in frontier or edge["to"] in frontier
            } - kept
            kept |= frontier
        nodes = {slug: node for slug, node in nodes.items() if slug in kept}
        edges = [edge for edge in edges if edge["from"] in kept and edge["to"] in kept]
    return {"nodes": list(nodes.values()), "edges": edges}


def tag_counts():
    """`brain_tags`: each tag, and each ancestor of a nested one, with its page count."""
    counts = {}
    for _, _, text in pages():
        carried = set()
        for tag in page_tags(text):
            parts = tag.split("/")
            carried |= {"/".join(parts[: at + 1]) for at in range(len(parts))}
        for tag in carried:
            counts[tag] = counts.get(tag, 0) + 1
    return [{"tag": tag, "count": counts[tag]} for tag in sorted(counts, key=str.lower)]


def render(slug):
    slug = clean(slug)
    path = in_vault(slug + ".md")
    if not os.path.isfile(path):
        return None
    with open(path, encoding="utf-8") as page:
        raw = page.read()
    properties, body = frontmatter(raw)
    values = dict(properties)
    links, unresolved = [], []
    for embed, destination in ((m.group(1), m.group(2)) for m in WIKILINK.finditer(body)):
        target = destination
        for cut in "#^":
            target = target.split(cut, 1)[0]
        target = target.strip().lstrip("/")
        target = target[2:] if target.startswith("./") else target
        target = target[:-3] if target.endswith(".md") else target
        resolved = slug if not target else resolve(target)
        links.append({"target": target, "slug": resolved, "alias": None, "embed": bool(embed)})
        if resolved is None and target not in unresolved:
            unresolved.append(target)
    return {
        "slug": slug,
        "title": str(values.get("title") or slug.rsplit("/", 1)[-1]),
        "page_type": str(values.get("type") or slug.split("/", 1)[0]),
        "properties": [{"key": key, "value": value} for key, value in properties],
        "raw": raw,
        "file": os.path.abspath(path),
        "html": "",
        "outline": [],
        "links": links,
        "unresolved": unresolved,
        "tasks": 0,
        "words": len(body.split()),
        "characters": len(body),
    }


VAULT_TOOLS = {
    "brain_tree": lambda arguments: tree(),
    "brain_search": lambda arguments: search(
        str(arguments.get("query") or ""),
        arguments.get("limit"),
        bool(arguments.get("case_sensitive")),
        bool(arguments.get("regex")),
    ),
    "brain_daily_note": lambda arguments: daily_note(arguments.get("date")),
    "brain_new_page": lambda arguments: new_page(
        str(arguments.get("folder") or ""), arguments.get("name"), arguments.get("path")
    ),
    "brain_get_links": lambda arguments: links(str(arguments.get("slug") or "")),
    "brain_graph": lambda arguments: graph(arguments.get("around"), arguments.get("depth")),
    "brain_tags": lambda arguments: tag_counts(),
    "brain_new_folder": lambda arguments: new_folder(str(arguments.get("path") or "")),
    "brain_rename": lambda arguments: rename(
        str(arguments.get("from") or ""), str(arguments.get("to") or "")
    ),
    "brain_delete_page": lambda arguments: delete_page(str(arguments.get("slug") or "")),
    "brain_delete_folder": lambda arguments: delete_folder(str(arguments.get("path") or "")),
    "brain_render": lambda arguments: render(str(arguments.get("slug") or "")),
}


def text(value):
    return {"content": [{"type": "text", "text": json.dumps(value, indent=2)}]}


def error(message_id, code, message):
    return {"jsonrpc": "2.0", "id": message_id, "error": {"code": code, "message": message}}


def answer(message):
    """The response to `message`, or None for a notification."""
    method = message.get("method")
    if "id" not in message:
        log(f"notification {method}")
        return None
    message_id = message["id"]
    params = message.get("params") or {}
    if method == "initialize":
        log("initialize")
        result = {
            "protocolVersion": params.get("protocolVersion", "2025-06-18"),
            "capabilities": {"tools": {}, "resources": {"listChanged": True}},
            "serverInfo": {"name": "rusty-mcp", "version": "stand-in"},
        }
    elif method == "ping":
        log("ping")
        result = {}
    elif method == "tools/list":
        log("tools/list")
        result = {
            "tools": [
                {"name": name, "description": name, "inputSchema": {"type": "object"}}
                for name in TOOL_NAMES
            ]
        }
    elif method == "tools/call":
        name = params.get("name")
        arguments = params.get("arguments") or {}
        log(f"tools/call {name} {json.dumps(arguments, sort_keys=True)}")
        settings = load()
        if name == "settings_list":
            result = text([{"key": key, "value": value} for key, value in sorted(settings.items())])
        elif name == "setting_get":
            result = text(settings.get(str(arguments.get("key"))))
        elif name == "setting_set":
            settings[str(arguments.get("key"))] = str(arguments.get("value"))
            save(settings)
            result = text("set")
        elif name in VAULT_TOOLS:
            try:
                result = text(VAULT_TOOLS[name](arguments))
            except Refused as refusal:
                return error(message_id, -32603, str(refusal))
        else:
            return error(message_id, -32602, f"tool not found: {name}")
    else:
        log(f"unknown {method}")
        return error(message_id, -32601, f"method not found: {method}")
    return {"jsonrpc": "2.0", "id": message_id, "result": result}


def stdio():
    out = threading.Lock()

    def send(message):
        with out:
            sys.stdout.write(json.dumps(message) + "\n")
            sys.stdout.flush()

    def watch():
        def stamp():
            seen = []
            for directory, folders, files in os.walk(VAULT):
                folders[:] = sorted(folder for folder in folders if not folder.startswith("."))
                for name in sorted(folders + files):
                    try:
                        changed = os.stat(os.path.join(directory, name)).st_mtime_ns
                    except OSError:
                        continue
                    seen.append((os.path.join(directory, name), changed))
            try:
                seen.append((SETTINGS, os.stat(SETTINGS).st_mtime_ns))
            except OSError:
                pass
            return seen

        last = stamp()
        while True:
            time.sleep(0.5)
            now = stamp()
            if now != last:
                last = now
                log("sent list_changed")
                send({"jsonrpc": "2.0", "method": "notifications/resources/list_changed"})

    threading.Thread(target=watch, daemon=True).start()
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            message = json.loads(line)
        except ValueError:
            continue
        response = answer(message)
        if response is not None:
            send(response)


class Handler(BaseHTTPRequestHandler):
    def do_POST(self):
        length = int(self.headers.get("Content-Length") or 0)
        try:
            message = json.loads(self.rfile.read(length) or b"{}")
        except ValueError:
            self.send_response(400)
            self.end_headers()
            return
        response = answer(message)
        if response is None:
            self.send_response(202)
            self.end_headers()
            return
        body = json.dumps(response).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_DELETE(self):
        self.send_response(200)
        self.end_headers()

    def log_message(self, *_):
        pass


def http(address):
    host, _, port = address.rpartition(":")
    server = ThreadingHTTPServer((host or "127.0.0.1", int(port)), Handler)
    bound = f"{server.server_address[0]}:{server.server_address[1]}"
    with open(os.path.join(STATE, "http-addr"), "w", encoding="utf-8") as written:
        written.write(bound + "\n")
    log(f"listening {bound}")
    server.serve_forever()


def main():
    seed()
    if len(sys.argv) == 3 and sys.argv[1] == "--http":
        http(sys.argv[2])
    else:
        stdio()


if __name__ == "__main__":
    main()
