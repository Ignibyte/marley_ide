def tasks_file():
    try:
        with open(TASKS, encoding="utf-8") as tasks:
            return json.load(tasks).get("groups", [])
    except (OSError, ValueError):
        return []


def save_tasks(groups):
    with LOCK:
        with open(TASKS + ".new", "w", encoding="utf-8") as stored:
            json.dump({"groups": groups}, stored, indent=2)
        os.replace(TASKS + ".new", TASKS)


def next_id(groups):
    """One more than the largest list or task id, so a new id is never one in use."""
    ids = [group["id"] for group in groups]
    ids += [task["id"] for group in groups for task in group.get("tasks", [])]
    return max(ids, default=0) + 1


def find_group(groups, group_id):
    return next((group for group in groups if group["id"] == group_id), None)


def find_task(groups, task_id):
    for group in groups:
        for task in group.get("tasks", []):
            if task["id"] == task_id:
                return group, task
    return None, None


def create_task_group(name):
    """Rusty's `create_task_group`: the new list last, its id answered."""
    groups = tasks_file()
    new = next_id(groups)
    groups.append({"id": new, "name": name, "tasks": []})
    save_tasks(groups)
    return new


def rename_task_group(group_id, name):
    """Rusty's `rename_task_group`; an id it does not hold changes nothing and succeeds."""
    groups = tasks_file()
    group = find_group(groups, group_id)
    if group is not None:
        group["name"] = name
        save_tasks(groups)
    return "renamed"


def delete_task_group(group_id):
    """Rusty's `delete_task_group`: the list and every task in it."""
    save_tasks([group for group in tasks_file() if group["id"] != group_id])
    return "deleted"


def create_task(group_id, title):
    """Rusty's `create_task`: the task last in its list, its id answered."""
    groups = tasks_file()
    group = find_group(groups, group_id)
    if group is None:
        raise Refused(f"No task group {group_id}")
    new = next_id(groups)
    group.setdefault("tasks", []).append({"id": new, "title": title})
    save_tasks(groups)
    return new


def change_task(task_id, change, word):
    """A write on one task; an id Rusty does not hold changes nothing and succeeds."""
    groups = tasks_file()
    group, task = find_task(groups, task_id)
    if task is not None:
        change(group, task)
        save_tasks(groups)
    return word


def toggle_task(task_id):
    """Rusty's `toggle_task`: the new state answered, a missing id refused as SQLite words it."""
    groups = tasks_file()
    _, task = find_task(groups, task_id)
    if task is None:
        raise Refused("Query error: Query returned no rows")
    task["completed"] = not task.get("completed")
    save_tasks(groups)
    return task["completed"]


def reorder_tasks(group_id, task_ids):
    """Rusty's `reorder_tasks`: the ids named first, in order, then the rest as they were."""
    groups = tasks_file()
    group = find_group(groups, group_id)
    if group is None:
        raise Refused(f"No task group {group_id}")
    held = {task["id"]: task for task in group.get("tasks", [])}
    for task_id in task_ids:
        if task_id not in held:
            raise Refused(f"Task {task_id} is not in group {group_id}")
    named = list(dict.fromkeys(task_ids))
    group["tasks"] = [held[task_id] for task_id in named] + [
        task for task in group.get("tasks", []) if task["id"] not in named
    ]
    save_tasks(groups)
    return "reordered"


def task_groups():
    """Rusty's `list_task_groups`, from `tasks.json` in the state folder."""
    return [
        {"id": group["id"], "name": group["name"], "sort_order": at}
        for at, group in enumerate(tasks_file())
    ]


def group_tasks(group_id, include_archived=False):
    """Rusty's `list_tasks` for one group."""
    for group in tasks_file():
        if group["id"] == group_id:
            return [
                {
                    "id": task["id"],
                    "header_id": group_id,
                    "title": task["title"],
                    "completed": bool(task.get("completed")),
                    "archived": bool(task.get("archived")),
                    "sort_order": at,
                    "created_at": 0,
                }
                for at, task in enumerate(group.get("tasks", []))
                if include_archived or not task.get("archived")
            ]
    return []


def flat(text):
    """Line breaks and runs of space as one space, the ends kept, as Rusty's `snippet_around`."""
    return re.sub(r"\s+", " ", text)


def search(query, limit, case_sensitive=False, regex=False):
    """Pages matching `query`: its `tag:` terms by the page's tags, the rest as one phrase (or a
    regular expression), each hit's snippet with the match between `<b>` and `</b>`; a query of
    `tag:` terms alone answers no snippet, as Rusty does."""
    terms = query.split()
    tags = [term[4:].lower() for term in terms if term.startswith("tag:")]
    phrase = " ".join(term for term in terms if not term.startswith("tag:"))
    hits = []
    for slug, title, text in pages():
        carried = [tag.lower() for tag in page_tags(text)]
        if not all(any(have == tag or have.startswith(tag + "/") for have in carried) for tag in tags):
            continue
        hit = {"slug": slug, "page_type": "note", "title": title, "snippet": "", "rank": 1.0}
        if not phrase:
            if tags:
                hits.append(hit)
            continue
        haystack = f"{title}\n{frontmatter(text)[1]}"
        flags = 0 if case_sensitive else re.IGNORECASE
        pattern = phrase if regex else re.escape(phrase)
        try:
            found = re.search(pattern, haystack, flags)
        except re.error as error:
            raise Refused(f"Invalid regex: {error}")
        if not found:
            continue
        start, end = found.span()
        hit["snippet"] = (
            flat(haystack[max(0, start - 40) : start])
            + "<b>"
            + flat(haystack[start:end])
            + "</b>"
            + flat(haystack[end : end + 60])
        ).strip()
        hits.append(hit)
    return hits[: limit or 10]


def write_page(slug, title):
    path = in_vault(slug + ".md")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as page:
        page.write(f"---\ntitle: {title}\n---\n")


def new_page(folder, name, path=None):
    if path and path.strip():
        # Rusty's TICKET-041: the page at exactly that path, folders made, an existing one as it is.
        slug = clean(path[:-3] if path.endswith(".md") else path)
        refuse_archive(slug)
        if not os.path.isfile(in_vault(slug + ".md")):
            write_page(slug, slug.rsplit("/", 1)[-1])
        return slug
    folder = clean(folder)
    refuse_archive(folder)
    if folder and not os.path.isdir(in_vault(folder)):
        raise Refused(f"No folder {folder}")
    base = (name or "").strip()
    base = base[:-3] if base.endswith(".md") else base
    base = base.replace("/", "-") or "Untitled"
    prefix = f"{folder}/" if folder else ""
    candidate, number = base, 1
    while os.path.exists(in_vault(f"{prefix}{candidate}.md")):
        candidate, number = f"{base} {number}", number + 1
    write_page(prefix + candidate, candidate)
    return prefix + candidate


def new_folder(path):
    path = clean(path)
    if not path:
        raise Refused("A folder needs a name")
    refuse_archive(path)
    if os.path.exists(in_vault(path)):
        raise Refused(f"Already exists: {path}")
    os.makedirs(in_vault(path))
    return path


def rename(source, target):
    source = clean(source[:-3] if source.endswith(".md") else source)
    into_folder = target.strip().endswith("/")
    target = clean(target[:-3] if target.endswith(".md") else target)
    if into_folder:
        name = source.rsplit("/", 1)[-1]
        target = f"{target}/{name}" if target else name
    if not target:
        raise Refused("A name is needed")
    refuse_archive(target)
    if os.path.isfile(in_vault(source + ".md")):
        if source != target:
            if os.path.exists(in_vault(target + ".md")):
                raise Refused(f"Already exists: {target}")
            os.makedirs(os.path.dirname(in_vault(target + ".md")), exist_ok=True)
            os.rename(in_vault(source + ".md"), in_vault(target + ".md"))
        kind = "page"
    elif os.path.isdir(in_vault(source)) and source:
        if target == source or target.startswith(source + "/"):
            raise Refused("Cannot move a folder into itself")
        if os.path.exists(in_vault(target)):
            raise Refused(f"Already exists: {target}")
        os.makedirs(os.path.dirname(in_vault(target)), exist_ok=True)
        os.rename(in_vault(source), in_vault(target))
        kind = "folder"
    else:
        raise Refused(f"Not found: {source}")
    rewritten = rewrite_links(source, target, kind)
    if kind == "page":
        follow_title(target, source.rsplit("/", 1)[-1], target.rsplit("/", 1)[-1])
    return {"from": source, "to": target, "kind": kind, "pages_rewritten": rewritten}


def rewrite_links(source, target, kind):
    """Rusty's link rewrite after a rename: `[[from]]`, `[[from|` and `[[from#` in every other
    page, a folder's pages by their prefix; the count of pages changed."""
    if kind == "page":
        pattern = re.compile(r"\[\[" + re.escape(source) + r"(?=[\]|#])")
        replace = lambda match: "[[" + target
    else:
        pattern = re.compile(r"\[\[" + re.escape(source) + "/")
        replace = lambda match: "[[" + target + "/"
    changed = 0
    for slug, _, text in pages():
        new = pattern.sub(replace, text)
        if new != text:
            with open(in_vault(slug + ".md"), "w", encoding="utf-8") as page:
                page.write(new)
            changed += 1
    return changed


def follow_title(slug, old_name, new_name):
    """Rusty's TICKET-046: a title equal to the old file name moves along with the rename."""
    path = in_vault(slug + ".md")
    with open(path, encoding="utf-8") as page:
        lines = page.read().split("\n")
    if not lines or lines[0].strip() != "---":
        return
    for at in range(1, len(lines)):
        if lines[at].strip() == "---":
            return
        key, _, value = lines[at].partition(":")
        if key.strip() == "title" and str(scalar(value)).lower() == old_name.lower():
            lines[at] = f"title: {new_name}"
            with open(path, "w", encoding="utf-8") as page:
                page.write("\n".join(lines))
            return


def archive(path):
    name = f"{os.path.basename(path)}_{int(time.time())}"
    shutil.move(path, os.path.join(VAULT, "archive", name))
    return f"archive/{name}"


def delete_page(slug):
    slug = clean(slug)
    path = in_vault(slug + ".md")
    if not os.path.isfile(path):
        raise Refused(f"Page not found: {slug}")
    archive(path)
    return "deleted"


def delete_folder(folder):
    folder = clean(folder)
    if not folder:
        raise Refused("Refusing to delete the vault root")
    if not os.path.isdir(in_vault(folder)):
        raise Refused(f"Folder not found: {folder}")
    return archive(in_vault(folder))


def daily_note(date):
    date = date or time.strftime("%Y-%m-%d")
    slug = f"daily/{date}"
    if not os.path.exists(in_vault(slug + ".md")):
        write_page(slug, date)
    return {
        "slug": slug,
        "page_type": "daily",
        "title": date,
        "compiled_truth": "",
        "timeline": "",
        "frontmatter": {"title": date, "type": "daily"},
        "content_hash": "",
        "created_at": 0,
        "updated_at": 0,
    }


WIKILINK = re.compile(r"(!?)\[\[([^\]|]*)(?:\|[^\]]*)?\]\]")


def scalar(text):
    """A YAML scalar as Rusty's frontmatter parser reads the simple ones."""
    text = text.strip()
    if len(text) >= 2 and text[0] == text[-1] and text[0] in "'\"":
        return text[1:-1]
    if text in ("true", "false"):
        return text == "true"
    if text in ("", "null", "~"):
        return None
    for kind in (int, float):
        try:
            return kind(text)
        except ValueError:
            pass
    return text


def frontmatter(raw):
    """The frontmatter's keys in file order, and the body: scalars, `[a, b]` lists and block lists."""
    lines = raw.split("\n")
    if not lines or lines[0].strip() != "---":
        return [], raw
    properties, key = [], None
    for at, line in enumerate(lines[1:], start=1):
        if line.strip() == "---":
            return properties, "\n".join(lines[at + 1 :])
        if line.startswith(("  - ", "- ")) and key is not None:
            value = properties[-1][1]
            properties[-1] = (key, (value if isinstance(value, list) else []) + [scalar(line.split("- ", 1)[1])])
        elif ":" in line and not line.startswith(" "):
            key, value = line.split(":", 1)
            key, value = key.strip(), value.strip()
            if value.startswith("[") and value.endswith("]"):
                properties.append((key, [scalar(part) for part in value[1:-1].split(",") if part.strip()]))
            else:
                properties.append((key, scalar(value)))
    return [], raw


def resolve(target):
    """The slug `target` names: its own path, else the one page with that name."""
    if not target:
        return None
    if os.path.isfile(in_vault(target + ".md")):
        return target
    named = [slug for slug, _, _ in pages() if slug.rsplit("/", 1)[-1] == target]
    return named[0] if len(named) == 1 else None


def target_of(destination):
    target = destination
    for cut in "#^":
        target = target.split(cut, 1)[0]
    target = target.strip().lstrip("/")
    target = target[2:] if target.startswith("./") else target
    return target[:-3] if target.endswith(".md") else target


INLINE_TAG = re.compile(r"(?<![\w/#&])#([A-Za-z][\w/-]*)")


def page_tags(raw):
    """The page's tags as Rusty's index holds them: the frontmatter's, then inline `#tags`."""
    properties, body = frontmatter(raw)
    value = dict(properties).get("tags")
    tags = [str(tag) for tag in value] if isinstance(value, list) else [str(value)] if value else []
    for line in body.split("\n"):
        tags += INLINE_TAG.findall(line)
    unique = []
    for tag in tags:
        if tag not in unique:
            unique.append(tag)
    return unique


def links(slug):
    """`brain_get_links`: the page's links in order, one per target, and the links to it."""
    slug = clean(slug)
    outbound, backlinks = [], []
    path = in_vault(slug + ".md")
    if os.path.isfile(path):
        with open(path, encoding="utf-8") as page:
            body = frontmatter(page.read())[1]
        seen = set()
        for line in body.split("\n"):
            for found in WIKILINK.finditer(line):
                target = target_of(found.group(2))
                if target in seen:
                    continue
                seen.add(target)
                resolved = slug if not target else resolve(target)
                outbound.append(
                    {
                        "from_slug": slug,
                        "to_slug": resolved or target,
                        "link_type": "wikilink",
                        "context": line.strip(),
                        "resolved": resolved is not None,
                    }
                )
    for other, _, text in pages():
        if other == slug:
            continue
        line = next(
            (
                line
                for line in frontmatter(text)[1].split("\n")
                if any(
                    target_of(found.group(2)) and resolve(target_of(found.group(2))) == slug
                    for found in WIKILINK.finditer(line)
                )
            ),
            None,
        )
        if line is not None:
            backlinks.append(
                {
                    "from_slug": other,
                    "to_slug": slug,
                    "link_type": "wikilink",
                    "context": line.strip(),
                    "resolved": True,
                }
            )
    return {"outbound": outbound, "backlinks": sorted(backlinks, key=lambda link: link["from_slug"])}


# Rusty's page types and their folders, in the order `brain_page_types` gives them.
TYPE_DIRS = [
    ("person", "people"),
    ("company", "companies"),
    ("project", "projects"),
    ("concept", "concepts"),
    ("meeting", "meetings"),
    ("idea", "ideas"),
    ("daily", "daily"),
    ("inbox", "inbox"),
    ("decision", "decisions"),
    ("conversation", "conversations"),
    ("source", "sources"),
]


def page_type(slug, properties):
    """Rusty's rule: the frontmatter's `type`, else the type its top folder names, else `note`."""
    stated = dict(properties).get("type")
    if stated:
        return str(stated)
    top = slug.split("/", 1)[0] if "/" in slug else ""
    return next((kind for kind, folder in TYPE_DIRS if folder == top), "note")


def as_list(value):
    if isinstance(value, list):
        return [str(each) for each in value if each is not None]
    return [str(value)] if value else []


def graph(arguments):
    """`brain_graph` as Rusty answers it: every page; a decision's typed edges first, so they win
    over the plain link between the same two pages; the resolved links; unresolved targets and
    tags as nodes on request; and with `around`, that page's neighbourhood `depth` edges out,
    breadth first over every edge. Pages are indexed once, so a vault of thousands answers in a
    moment."""
    found = pages()
    known = {slug for slug, _, _ in found}
    names = {}
    for slug, _, _ in found:
        names.setdefault(slug.rsplit("/", 1)[-1], []).append(slug)

    def resolved(target):
        if not target:
            return None
        if target in known:
            return target
        named = names.get(target, [])
        return named[0] if len(named) == 1 else None

    nodes, edges, seen, ids, parsed = [], [], set(), set(known), []
    for slug, title, text in found:
        properties, body = frontmatter(text)
        kind = page_type(slug, properties)
        parsed.append((slug, kind, dict(properties), body, page_tags(text)))
        nodes.append(
            {
                "id": slug,
                "kind": "page",
                "title": title,
                "page_type": kind,
                "folder": slug.rsplit("/", 1)[0] if "/" in slug else "",
                "tags": parsed[-1][4],
            }
        )

    def edge(source, target, kind):
        if (source, target) not in seen:
            seen.add((source, target))
            edges.append({"from": source, "to": target, "kind": kind})

    for slug, kind, properties, _, _ in parsed:
        if kind != "decision":
            continue
        typed = [(target, "consulted") for target in as_list(properties.get("consulted"))]
        typed += [(target, "supersedes") for target in as_list(properties.get("supersedes"))[:1]]
        typed += [(target, "follows_up") for target in as_list(properties.get("superseded_by"))[:1]]
        for target, name in typed:
            if target in known:
                edge(slug, target, name)
    for slug, _, _, body, _ in parsed:
        for hit in WIKILINK.finditer(body):
            target = target_of(hit.group(2))
            to = resolved(target)
            if to and to != slug:
                edge(slug, to, "link")
            elif to is None and target and arguments.get("unresolved"):
                node = "new:" + target
                if node not in ids:
                    ids.add(node)
                    nodes.append(
                        {"id": node, "kind": "unresolved", "title": target, "page_type": "", "folder": "", "tags": []}
                    )
                edge(slug, node, "link")
    if arguments.get("tags"):
        for slug, _, _, _, tags in parsed:
            for tag in tags:
                node = "tag:" + tag.lower()
                if node not in ids:
                    ids.add(node)
                    nodes.append(
                        {"id": node, "kind": "tag", "title": "#" + tag, "page_type": "", "folder": "", "tags": []}
                    )
                edge(slug, node, "link")
    around = clean(str(arguments.get("around") or "").strip())
    if not around:
        return {"nodes": nodes, "edges": edges}
    adjacent = {}
    for each in edges:
        adjacent.setdefault(each["from"], []).append(each["to"])
        adjacent.setdefault(each["to"], []).append(each["from"])
    keep, queue = set(), []
    if around in ids:
        keep, queue = {around}, [(around, 0)]
    depth = max(1, int(arguments.get("depth") or 1))
    while queue:
        node, far = queue.pop(0)
        if far >= depth:
            continue
        for other in adjacent.get(node, []):
            if other not in keep:
                keep.add(other)
                queue.append((other, far + 1))
    return {
        "nodes": [node for node in nodes if node["id"] in keep],
        "edges": [each for each in edges if each["from"] in keep and each["to"] in keep],
    }


def page_types():
    """`brain_page_types`: Rusty's types in order, each with its folder and page count."""
    counts = {}
    for slug, _, text in pages():
        kind = page_type(slug, frontmatter(text)[0])
        counts[kind] = counts.get(kind, 0) + 1
    return [{"page_type": kind, "dir": folder, "count": counts.get(kind, 0)} for kind, folder in TYPE_DIRS]


def tag_counts():
    """`brain_tags`: each tag, and each ancestor of a nested one, with its page count."""
    counts = {}
    for _, _, text in pages():
        carried = set()
        for tag in page_tags(text):
            parts = tag.split("/")
            carried |= {"/".join(parts[: at + 1]) for at in range(len(parts))}
        for tag in carried:
            counts[tag] = counts.get(tag, 0) + 1
    return [{"tag": tag, "count": counts[tag]} for tag in sorted(counts, key=str.lower)]


def outline(body):
    """Rusty's outline: each ATX heading outside a fence, its level, its text as written and its
    line in the body from 0."""
    headings, fence = [], False
    for at, line in enumerate(body.split("\n")):
        stripped = line.lstrip()
        if stripped.startswith(("```", "~~~")):
            fence = not fence
            continue
        if fence:
            continue
        hashes = len(stripped) - len(stripped.lstrip("#"))
        rest = stripped[hashes:]
        if 1 <= hashes <= 6 and rest[:1] in (" ", "\t"):
            text = rest.strip().rstrip("#").strip()
            if text:
                headings.append({"level": hashes, "text": text, "line": at})
    return headings


def render(slug):
    slug = clean(slug)
    path = in_vault(slug + ".md")
    if not os.path.isfile(path):
        return None
    with open(path, encoding="utf-8") as page:
        raw = page.read()
    properties, body = frontmatter(raw)
    values = dict(properties)
    links, unresolved = [], []
    for embed, destination in ((m.group(1), m.group(2)) for m in WIKILINK.finditer(body)):
        target = destination
        for cut in "#^":
            target = target.split(cut, 1)[0]
        target = target.strip().lstrip("/")
        target = target[2:] if target.startswith("./") else target
        target = target[:-3] if target.endswith(".md") else target
        resolved = slug if not target else resolve(target)
        links.append({"target": target, "slug": resolved, "alias": None, "embed": bool(embed)})
        if resolved is None and target not in unresolved:
            unresolved.append(target)
    return {
        "slug": slug,
        "title": str(values.get("title") or slug.rsplit("/", 1)[-1]),
        "page_type": str(values.get("type") or slug.split("/", 1)[0]),
        "properties": [{"key": key, "value": value} for key, value in properties],
        "raw": raw,
        "file": os.path.abspath(path),
        "html": "",
        "outline": outline(body),
        "links": links,
        "unresolved": unresolved,
        "tasks": 0,
        "words": len(body.split()),
        "characters": len(body),
    }


