        os.replace(SETTINGS + ".new", SETTINGS)


def seed():
    os.makedirs(STATE, exist_ok=True)
    os.makedirs(os.path.join(VAULT, "archive"), exist_ok=True)
    if os.path.exists(SETTINGS):
        settings = load()
    else:
        with open(FIXTURE, encoding="utf-8") as fixture:
            settings = {entry["key"]: entry["value"] for entry in json.load(fixture)}
    if "brain_vault_path" not in settings:
        settings["brain_vault_path"] = VAULT
        save(settings)
    elif not os.path.exists(SETTINGS):
        save(settings)


class Refused(Exception):
    """A tool's refusal, worded as Rusty words it."""


def clean(path):
    return "/".join(part for part in str(path).strip().split("/") if part and part != ".")


def in_vault(rel):
    if ".." in rel.split("/"):
        raise Refused("Invalid path: path traversal not allowed")
    return os.path.join(VAULT, rel) if rel else VAULT


def refuse_archive(rel):
    if rel == "archive" or rel.startswith("archive/"):
        raise Refused(
            "archive/ holds deleted pages; delete a page to archive it, or move one out to restore it"
        )


def tree():
    def node(name, rel, directory):
        folders, files = [], []
        for entry in os.listdir(directory):
            if entry.startswith(".") or (not rel and entry == "archive"):
                continue
            path = os.path.join(directory, entry)
            child = f"{rel}/{entry}" if rel else entry
            if os.path.isdir(path):
                folders.append(node(entry, child, path))
            elif os.path.isfile(path):
                page = entry.endswith(".md")
                files.append(
                    {
                        "name": entry[:-3] if page else entry,
                        "path": child[:-3] if page else child,
                        "kind": "page" if page else "file",
                        "pages": int(page),
                        "children": [],
                    }
                )
        folders.sort(key=lambda found: found["name"].lower())
        files.sort(key=lambda found: found["name"].lower())
        children = folders + files
        return {
            "name": name,
            "path": rel,
            "kind": "folder",
            "pages": sum(child["pages"] for child in children),
            "children": children,
        }

    return node(os.path.basename(VAULT), "", VAULT)


def pages():
    """Every page outside `archive/`, as (slug, title, text)."""
    found = []
    for directory, folders, files in os.walk(VAULT):
        folders[:] = [folder for folder in folders if not folder.startswith(".")]
        rel = os.path.relpath(directory, VAULT)
        if rel == "archive" or rel.startswith("archive/"):
            continue
        for name in files:
            if not name.endswith(".md"):
                continue
            slug = clean(os.path.join(rel, name[:-3]))
            with open(os.path.join(directory, name), encoding="utf-8") as page:
                text = page.read()
            title = next(
                (line[6:].strip() for line in text.splitlines() if line.startswith("title:")),
                name[:-3],
            )
            found.append((slug, title, text))
    return sorted(found)


def list_pages(limit, wanted_type=None, properties=()):
    """Every page outside `archive/`, the most recently changed file first, as Rusty's
    `brain_list_pages`: 50 unless `limit` says otherwise, typed as Rusty types a page, with its
    aliases and the properties asked for."""
    found = []
    for slug, title, text in pages():
        fields, _ = frontmatter(text)
        kind = page_type(slug, fields)
        if wanted_type and kind != wanted_type:
            continue
        found.append((os.path.getmtime(in_vault(slug + ".md")), slug, title, kind, dict(fields)))
    found.sort(key=lambda page: (-page[0], page[1]))
    count = 50 if limit is None else max(int(limit), 0)
    listed = []
    for changed, slug, title, kind, fields in found[:count]:
        aliases = fields.get("aliases") or []
        entry = {
            "slug": slug,
            "page_type": kind,
            "title": title,
            "updated_at": int(changed),
            "aliases": aliases if isinstance(aliases, list) else [aliases],
        }
        if properties:
            entry["properties"] = {key: fields[key] for key in properties if key in fields}
        listed.append(entry)
    return listed


def read_page(slug):
    """Rusty's `brain_read_page`: the page with its frontmatter, `None` when there is none."""
    slug = clean(slug)
    path = in_vault(slug + ".md")
    if not os.path.isfile(path):
        return None
    with open(path, encoding="utf-8") as page:
        raw = page.read()
    fields, body = frontmatter(raw)
    compiled = body.split("\n## Timeline", 1)[0]
    meta = dict(fields)
    meta.setdefault("title", slug.rsplit("/", 1)[-1])
    meta.setdefault("type", page_type(slug, fields))
    return {
        "slug": slug,
        "page_type": page_type(slug, fields),
        "title": meta["title"],
        "compiled_truth": compiled.strip("\n"),
        "timeline": "",
        "frontmatter": meta,
        "updated_at": int(os.path.getmtime(path)),
    }


def today_in_state():
    """The day the stand-in takes as today: the state folder's `today` file when a scenario
    fixes it (#659), else the local date."""
    try:
        with open(os.path.join(STATE, "today"), encoding="utf-8") as fixed:
            return date.fromisoformat(fixed.read().strip())
    except (OSError, ValueError):
        return date.today()


def due(days):
    """Rusty's `brain_due`: decided or revised decisions whose follow-up is on or before today
    plus `days`, the follow-up day first; `overdue` before today; and every decision, the
    newest decided first, as Rusty sorts them."""
    day = today_in_state()
    today = day.isoformat()
    horizon = (day + timedelta(days=int(days or 0))).isoformat()
    summaries = []
    for slug, title, text in pages():
        fields = dict(frontmatter(text)[0])
        if page_type(slug, frontmatter(text)[0]) != "decision":
            continue
        follow_up = str(fields.get("follow_up_by") or "")
        summaries.append({
            "slug": slug,
            "title": title,
            "question": "",
            "status": str(fields.get("status") or "decided"),
            "decided": str(fields.get("decided") or ""),
            "follow_up_by": follow_up,
            "overdue": bool(follow_up) and follow_up < today,
            "followed_up": False,
            "superseded_by": None,
        })
    due_now = [
        summary for summary in summaries
        if summary["status"] in ("decided", "revised") and summary["follow_up_by"]
        and summary["follow_up_by"] <= horizon
    ]
    due_now.sort(key=lambda summary: (summary["follow_up_by"], summary["slug"]))
    summaries.sort(key=lambda summary: summary["slug"])
    summaries.sort(key=lambda summary: summary["decided"], reverse=True)
    return {"due": due_now, "all": summaries}


def yaml_value(value):
    """A value as one frontmatter line's text, or a block list's lines."""
    if isinstance(value, list):
        return "\n" + "\n".join(f"  - {json.dumps(str(item))}" for item in value)
    if isinstance(value, bool):
        return " true" if value else " false"
    return " " + json.dumps(value)


def frontmatter_lines(slug):
    """The page's lines and where its frontmatter closes, a frontmatter added when it has none."""
    slug = clean(slug)
    path = in_vault(slug + ".md")
    if not os.path.isfile(path):
        raise Refused(f"Page not found: {slug}")
    with open(path, encoding="utf-8") as page:
        lines = page.read().split("\n")
    if not lines or lines[0].strip() != "---":
        lines = ["---", "---"] + lines
    close = next((at for at in range(1, len(lines)) if lines[at].strip() == "---"), None)
    if close is None:
        raise Refused(f"The frontmatter of {slug} does not close")
    return path, lines, close


def key_span(lines, close, key):
    """The lines a key holds, its block list included, or None."""
    for at in range(1, close):
        if lines[at].split(":", 1)[0].strip() == key and not lines[at].startswith(" "):
            end = at + 1
            while end < close and lines[end].startswith(("  - ", "- ")):
                end += 1
            return at, end
    return None


def set_property(slug, key, value):
    """Rusty's `brain_set_property`: a key replaced where it is, a new one at the frontmatter's
    end; the other keys in order and the body as it was."""
    if not key.strip():
        raise Refused("A property needs a key")
    path, lines, close = frontmatter_lines(slug)
    line = f"{key}:{yaml_value(value)}"
    span = key_span(lines, close, key)
    if span:
        lines = lines[: span[0]] + [line] + lines[span[1] :]
    else:
        lines = lines[:close] + [line] + lines[close:]
    with open(path, "w", encoding="utf-8") as page:
        page.write("\n".join(lines))
    return read_page(slug)


def remove_property(slug, key):
    """Rusty's `brain_remove_property`: the key and its block list gone, the rest as it was."""
    path, lines, close = frontmatter_lines(slug)
    span = key_span(lines, close, key)
    if span:
        lines = lines[: span[0]] + lines[span[1] :]
        with open(path, "w", encoding="utf-8") as page:
            page.write("\n".join(lines))
    return read_page(slug)


