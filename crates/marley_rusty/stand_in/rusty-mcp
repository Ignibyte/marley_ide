def failing(name):
    """The error the state folder's `fail` file gives tool `name`: its first line names the tool,
    its second is the message."""
    try:
        with open(os.path.join(STATE, "fail"), encoding="utf-8") as fail:
            lines = fail.read().splitlines()
    except OSError:
        return None
    if lines and lines[0].strip() == name:
        return lines[1] if len(lines) > 1 else f"{name} failed"
    return None


def text(value):
    return {"content": [{"type": "text", "text": json.dumps(value, indent=2)}]}


def error(message_id, code, message):
    return {"jsonrpc": "2.0", "id": message_id, "error": {"code": code, "message": message}}


def answer(message):
    """The response to `message`, or None for a notification."""
    method = message.get("method")
    if "id" not in message:
        log(f"notification {method}")
        return None
    message_id = message["id"]
    params = message.get("params") or {}
    if method == "initialize":
        log("initialize")
        result = {
            "protocolVersion": params.get("protocolVersion", "2025-06-18"),
            "capabilities": {"tools": {}, "resources": {"listChanged": True}},
            "serverInfo": {"name": "rusty-mcp", "version": "stand-in"},
        }
    elif method == "ping":
        log("ping")
        result = {}
    elif method == "tools/list":
        log("tools/list")
        result = {
            "tools": [
                {"name": name, "description": name, "inputSchema": {"type": "object"}}
                for name in TOOL_NAMES
            ]
        }
    elif method == "tools/call":
        name = params.get("name")
        arguments = params.get("arguments") or {}
        log(f"tools/call {name} {json.dumps(arguments, sort_keys=True)}")
        settings = load()
        if name == "settings_list":
            result = text([{"key": key, "value": value} for key, value in sorted(settings.items())])
        elif name == "setting_get":
            result = text(settings.get(str(arguments.get("key"))))
        elif name == "setting_set":
            settings[str(arguments.get("key"))] = str(arguments.get("value"))
            save(settings)
            result = text("set")
        elif failing(name) is not None:
            # A scenario's `fail` file makes the tool it names fail as `rusty-mcp` fails (#659).
            return error(message_id, -32603, failing(name))
        elif name in VAULT_TOOLS:
            try:
                result = text(VAULT_TOOLS[name](arguments))
            except Refused as refusal:
                return error(message_id, -32603, str(refusal))
        else:
            return error(message_id, -32602, f"tool not found: {name}")
    else:
        log(f"unknown {method}")
        return error(message_id, -32601, f"method not found: {method}")
    return {"jsonrpc": "2.0", "id": message_id, "result": result}


def stdio():
    out = threading.Lock()

    def send(message):
        with out:
            sys.stdout.write(json.dumps(message) + "\n")
            sys.stdout.flush()

    def watch():
        def stamp():
            seen = []
            for directory, folders, files in os.walk(VAULT):
                folders[:] = sorted(folder for folder in folders if not folder.startswith("."))
                for name in sorted(folders + files):
                    try:
                        changed = os.stat(os.path.join(directory, name)).st_mtime_ns
                    except OSError:
                        continue
                    seen.append((os.path.join(directory, name), changed))
            try:
                seen.append((SETTINGS, os.stat(SETTINGS).st_mtime_ns))
            except OSError:
                pass
            return seen

        last = stamp()
        while True:
            time.sleep(0.5)
            now = stamp()
            if now != last:
                last = now
                log("sent list_changed")
                send({"jsonrpc": "2.0", "method": "notifications/resources/list_changed"})

    threading.Thread(target=watch, daemon=True).start()
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            message = json.loads(line)
        except ValueError:
            continue
        response = answer(message)
        if response is not None:
            send(response)
            # Rusty announces each task write that succeeded to every peer (#658).
            params = message.get("params") or {}
            if params.get("name") in TASK_WRITES and "error" not in response:
                log("sent list_changed")
                send({"jsonrpc": "2.0", "method": "notifications/resources/list_changed"})


class Handler(BaseHTTPRequestHandler):
    def do_POST(self):
        length = int(self.headers.get("Content-Length") or 0)
        try:
            message = json.loads(self.rfile.read(length) or b"{}")
        except ValueError:
            self.send_response(400)
            self.end_headers()
            return
        response = answer(message)
        if response is None:
            self.send_response(202)
            self.end_headers()
            return
        body = json.dumps(response).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_DELETE(self):
        self.send_response(200)
        self.end_headers()

    def log_message(self, *_):
        pass


def http(address):
    host, _, port = address.rpartition(":")
    server = ThreadingHTTPServer((host or "127.0.0.1", int(port)), Handler)
    bound = f"{server.server_address[0]}:{server.server_address[1]}"
    with open(os.path.join(STATE, "http-addr"), "w", encoding="utf-8") as written:
        written.write(bound + "\n")
    log(f"listening {bound}")
    server.serve_forever()


def main():
    seed()
    if len(sys.argv) == 3 and sys.argv[1] == "--http":
        http(sys.argv[2])
    else:
        stdio()


if __name__ == "__main__":
    main()
