def tasks_file():
    try:
        with open(TASKS, encoding="utf-8") as tasks:
            return json.load(tasks).get("groups", [])
    except (OSError, ValueError):
        return []


def save_tasks(groups):
    with LOCK:
        with open(TASKS + ".new", "w", encoding="utf-8") as stored:
            json.dump({"groups": groups}, stored, indent=2)
        os.replace(TASKS + ".new", TASKS)


def next_id(groups):
    """One more than the largest list or task id, so a new id is never one in use."""
    ids = [group["id"] for group in groups]
    ids += [task["id"] for group in groups for task in group.get("tasks", [])]
    return max(ids, default=0) + 1


def find_group(groups, group_id):
    return next((group for group in groups if group["id"] == group_id), None)


def find_task(groups, task_id):
    for group in groups:
        for task in group.get("tasks", []):
            if task["id"] == task_id:
                return group, task
    return None, None


def create_task_group(name):
    """Rusty's `create_task_group`: the new list last, its id answered."""
    groups = tasks_file()
    new = next_id(groups)
    groups.append({"id": new, "name": name, "tasks": []})
    save_tasks(groups)
    return new


def rename_task_group(group_id, name):
    """Rusty's `rename_task_group`; an id it does not hold changes nothing and succeeds."""
    groups = tasks_file()
    group = find_group(groups, group_id)
    if group is not None:
        group["name"] = name
        save_tasks(groups)
    return "renamed"


def delete_task_group(group_id):
    """Rusty's `delete_task_group`: the list and every task in it."""
    save_tasks([group for group in tasks_file() if group["id"] != group_id])
    return "deleted"


def create_task(group_id, title):
    """Rusty's `create_task`: the task last in its list, its id answered."""
    groups = tasks_file()
    group = find_group(groups, group_id)
    if group is None:
        raise Refused(f"No task group {group_id}")
    new = next_id(groups)
    group.setdefault("tasks", []).append({"id": new, "title": title})
    save_tasks(groups)
    return new


def change_task(task_id, change, word):
    """A write on one task; an id Rusty does not hold changes nothing and succeeds."""
    groups = tasks_file()
    group, task = find_task(groups, task_id)
    if task is not None:
        change(group, task)
        save_tasks(groups)
    return word


def toggle_task(task_id):
    """Rusty's `toggle_task`: the new state answered, a missing id refused as SQLite words it."""
    groups = tasks_file()
    _, task = find_task(groups, task_id)
    if task is None:
        raise Refused("Query error: Query returned no rows")
    task["completed"] = not task.get("completed")
    save_tasks(groups)
    return task["completed"]


def reorder_tasks(group_id, task_ids):
    """Rusty's `reorder_tasks`: the ids named first, in order, then the rest as they were."""
    groups = tasks_file()
    group = find_group(groups, group_id)
    if group is None:
        raise Refused(f"No task group {group_id}")
    held = {task["id"]: task for task in group.get("tasks", [])}
    for task_id in task_ids:
        if task_id not in held:
            raise Refused(f"Task {task_id} is not in group {group_id}")
    named = list(dict.fromkeys(task_ids))
    group["tasks"] = [held[task_id] for task_id in named] + [
        task for task in group.get("tasks", []) if task["id"] not in named
    ]
    save_tasks(groups)
    return "reordered"


def task_groups():
    """Rusty's `list_task_groups`, from `tasks.json` in the state folder."""
    return [
        {"id": group["id"], "name": group["name"], "sort_order": at}
        for at, group in enumerate(tasks_file())
    ]


def group_tasks(group_id, include_archived=False):
    """Rusty's `list_tasks` for one group."""
    for group in tasks_file():
        if group["id"] == group_id:
            return [
                {
                    "id": task["id"],
                    "header_id": group_id,
                    "title": task["title"],
                    "completed": bool(task.get("completed")),
                    "archived": bool(task.get("archived")),
                    "sort_order": at,
                    "created_at": 0,
                }
                for at, task in enumerate(group.get("tasks", []))
                if include_archived or not task.get("archived")
            ]
    return []


def flat(text):
    """Line breaks and runs of space as one space, the ends kept, as Rusty's `snippet_around`."""
    return re.sub(r"\s+", " ", text)


def search(query, limit, case_sensitive=False, regex=False):
    """Pages matching `query`: its `tag:` terms by the page's tags, the rest as one phrase (or a
    regular expression), each hit's snippet with the match between `<b>` and `</b>`; a query of
    `tag:` terms alone answers no snippet, as Rusty does."""
    terms = query.split()
    tags = [term[4:].lower() for term in terms if term.startswith("tag:")]
    phrase = " ".join(term for term in terms if not term.startswith("tag:"))
    hits = []
    for slug, title, text in pages():
        carried = [tag.lower() for tag in page_tags(text)]
        if not all(any(have == tag or have.startswith(tag + "/") for have in carried) for tag in tags):
            continue
        hit = {"slug": slug, "page_type": "note", "title": title, "snippet": "", "rank": 1.0}
        if not phrase:
            if tags:
                hits.append(hit)
            continue
        haystack = f"{title}\n{frontmatter(text)[1]}"
        flags = 0 if case_sensitive else re.IGNORECASE
        pattern = phrase if regex else re.escape(phrase)
        try:
            found = re.search(pattern, haystack, flags)
        except re.error as error:
            raise Refused(f"Invalid regex: {error}")
        if not found:
            continue
        start, end = found.span()
        hit["snippet"] = (
            flat(haystack[max(0, start - 40) : start])
            + "<b>"
            + flat(haystack[start:end])
            + "</b>"
            + flat(haystack[end : end + 60])
        ).strip()
        hits.append(hit)
    return hits[: limit or 10]


def write_page(slug, title):
    path = in_vault(slug + ".md")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as page:
        page.write(f"---\ntitle: {title}\n---\n")


def new_page(folder, name, path=None):
    if path and path.strip():
        # Rusty's TICKET-041: the page at exactly that path, folders made, an existing one as it is.
        slug = clean(path[:-3] if path.endswith(".md") else path)
        refuse_archive(slug)
        if not os.path.isfile(in_vault(slug + ".md")):
            write_page(slug, slug.rsplit("/", 1)[-1])
        return slug
    folder = clean(folder)
    refuse_archive(folder)
    if folder and not os.path.isdir(in_vault(folder)):
        raise Refused(f"No folder {folder}")
    base = (name or "").strip()
    base = base[:-3] if base.endswith(".md") else base
    base = base.replace("/", "-") or "Untitled"
    prefix = f"{folder}/" if folder else ""
    candidate, number = base, 1
    while os.path.exists(in_vault(f"{prefix}{candidate}.md")):
        candidate, number = f"{base} {number}", number + 1
    write_page(prefix + candidate, candidate)
    return prefix + candidate


def new_folder(path):
    path = clean(path)
    if not path:
        raise Refused("A folder needs a name")
    refuse_archive(path)
    if os.path.exists(in_vault(path)):
        raise Refused(f"Already exists: {path}")
    os.makedirs(in_vault(path))
    return path


def rename(source, target):
    source = clean(source[:-3] if source.endswith(".md") else source)
    into_folder = target.strip().endswith("/")
    target = clean(target[:-3] if target.endswith(".md") else target)
    if into_folder:
        name = source.rsplit("/", 1)[-1]
        target = f"{target}/{name}" if target else name
    if not target:
        raise Refused("A name is needed")
    refuse_archive(target)
    if os.path.isfile(in_vault(source + ".md")):
        if source != target:
            if os.path.exists(in_vault(target + ".md")):
                raise Refused(f"Already exists: {target}")
            os.makedirs(os.path.dirname(in_vault(target + ".md")), exist_ok=True)
            os.rename(in_vault(source + ".md"), in_vault(target + ".md"))
        kind = "page"
    elif os.path.isdir(in_vault(source)) and source:
        if target == source or target.startswith(source + "/"):
            raise Refused("Cannot move a folder into itself")
        if os.path.exists(in_vault(target)):
            raise Refused(f"Already exists: {target}")
        os.makedirs(os.path.dirname(in_vault(target)), exist_ok=True)
        os.rename(in_vault(source), in_vault(target))
        kind = "folder"
    else:
        raise Refused(f"Not found: {source}")
    rewritten = rewrite_links(source, target, kind)
    follow_bookmarks(source, target, kind)
    if kind == "page":
        follow_title(target, source.rsplit("/", 1)[-1], target.rsplit("/", 1)[-1])
    return {"from": source, "to": target, "kind": kind, "pages_rewritten": rewritten}


def rewrite_links(source, target, kind):
    """Rusty's link rewrite after a rename: `[[from]]`, `[[from|` and `[[from#` in every other
    page, a folder's pages by their prefix; the count of pages changed."""
    if kind == "page":
        pattern = re.compile(r"\[\[" + re.escape(source) + r"(?=[\]|#])")
        replace = lambda match: "[[" + target
    else:
        pattern = re.compile(r"\[\[" + re.escape(source) + "/")
        replace = lambda match: "[[" + target + "/"
    changed = 0
    for slug, _, text in pages():
        new = pattern.sub(replace, text)
        if new != text:
            with open(in_vault(slug + ".md"), "w", encoding="utf-8") as page:
                page.write(new)
            changed += 1
    return changed


def follow_title(slug, old_name, new_name):
    """Rusty's TICKET-046: a title equal to the old file name moves along with the rename."""
    path = in_vault(slug + ".md")
    with open(path, encoding="utf-8") as page:
        lines = page.read().split("\n")
    if not lines or lines[0].strip() != "---":
        return
    for at in range(1, len(lines)):
        if lines[at].strip() == "---":
            return
        key, _, value = lines[at].partition(":")
        if key.strip() == "title" and str(scalar(value)).lower() == old_name.lower():
            lines[at] = f"title: {new_name}"
            with open(path, "w", encoding="utf-8") as page:
                page.write("\n".join(lines))
            return


BOOKMARKS = os.path.join(VAULT, ".rusty", "bookmarks.json")

BOOKMARK_KINDS = ("file", "folder", "search", "heading")


def load_bookmarks():
    try:
        with open(BOOKMARKS, encoding="utf-8") as stored:
            return json.load(stored)
    except (OSError, ValueError):
        return []


def bookmark_key(bookmark):
    """Rusty's identity for a bookmark: its kind, and its path, query or page and heading."""
    kind = bookmark.get("kind", "")
    if kind == "search":
        return f"search:{bookmark.get('query', '')}"
    if kind == "heading":
        return f"heading:{bookmark.get('path', '')}#{bookmark.get('heading', '')}"
    return f"{kind}:{bookmark.get('path', '')}"


def checked_bookmark(fields):
    """A bookmark from a tool's parameters, refused as Rusty refuses it, its title filled."""
    bookmark = {key: str(fields.get(key) or "").strip() for key in ("kind", "title", "path", "query", "heading")}
    kind = bookmark["kind"]
    if kind not in BOOKMARK_KINDS:
        raise Refused(f"Unknown bookmark kind: {kind}")
    if kind in ("file", "folder", "heading") and not bookmark["path"]:
        raise Refused(f"A {kind} bookmark needs a path")
    if kind == "search" and not bookmark["query"]:
        raise Refused("A search bookmark needs a query")
    if kind == "heading" and not bookmark["heading"]:
        raise Refused("A heading bookmark needs a heading")
    if not bookmark["title"]:
        bookmark["title"] = {
            "search": bookmark["query"],
            "heading": bookmark["heading"],
        }.get(kind, bookmark["path"].rsplit("/", 1)[-1])
    return {key: value for key, value in bookmark.items() if value}


def save_bookmarks(bookmarks):
    """Rusty's store: duplicates by key dropped, the first kept, in order."""
    kept, seen = [], set()
    for bookmark in bookmarks:
        if bookmark_key(bookmark) not in seen:
            seen.add(bookmark_key(bookmark))
            kept.append(bookmark)
    os.makedirs(os.path.dirname(BOOKMARKS), exist_ok=True)
    with open(BOOKMARKS, "w", encoding="utf-8") as stored:
        json.dump(kept, stored, indent=2)
    return kept


def bookmark_add(fields):
    bookmark = checked_bookmark(fields)
    return save_bookmarks(load_bookmarks() + [bookmark])


def bookmark_remove(fields):
    key = bookmark_key({key: str(value or "").strip() for key, value in fields.items()})
    bookmarks = load_bookmarks()
    kept = [bookmark for bookmark in bookmarks if bookmark_key(bookmark) != key]
    if len(kept) == len(bookmarks):
        raise Refused(f"No bookmark {key}")
    return save_bookmarks(kept)


def bookmark_set(items):
    return save_bookmarks([checked_bookmark(item) for item in items or []])


def follow_bookmarks(source, target, kind):
    """Rusty's rename rule: a page's and a folder's bookmarks follow it; searches stay."""
    bookmarks = load_bookmarks()
    if not os.path.exists(BOOKMARKS):
        return
    for bookmark in bookmarks:
        path = bookmark.get("path", "")
        if bookmark.get("kind") == "search" or not path:
            continue
        if path == source:
            bookmark["path"] = target
        elif kind == "folder" and path.startswith(source + "/"):
            bookmark["path"] = target + path[len(source):]
    save_bookmarks(bookmarks)


def drop_bookmarks(path, folder):
    """Rusty's delete rule: the bookmarks of a deleted page, or of anything in a deleted folder."""
    if not os.path.exists(BOOKMARKS):
        return
    save_bookmarks([
        bookmark for bookmark in load_bookmarks()
        if bookmark.get("kind") == "search"
        or not (bookmark.get("path", "") == path or (folder and bookmark.get("path", "").startswith(path + "/")))
    ])


def archive(path):
    name = f"{os.path.basename(path)}_{int(time.time())}"
    shutil.move(path, os.path.join(VAULT, "archive", name))
