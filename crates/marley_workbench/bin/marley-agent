#!/usr/bin/env python3
"""Reports an agent's state to the Marley terminal it runs in (#652).

Marley names this program as `MARLEY_BIN` in its local terminals. An agent's plugin runs
`"$MARLEY_BIN" report STATE --source S --seq N ...` and `"$MARLEY_BIN" release --source S` with
exactly the arguments `rh report` and `rh release` take after `--state ROOT`, so one plugin reports
to either host. The program checks no field rule: it sends the report, with the terminal's
`MARLEY_TERMINAL_ID`, as one JSON line over the socket of the Marley that wrote it (named in
`agent-socket` beside it), and Marley answers whether it took it. Accepted, it prints nothing and
exits 0; refused, it prints the refusal's name and reason on stderr and exits 1; when no Marley
answers, `marley_not_running`. Arguments `rh` would refuse to parse exit 2.

Since #726, `"$MARLEY_BIN" approve --source S --call ID --tool NAME`, with the tool's input as JSON
on stdin, asks the user to decide a tool call, as `rh approve` does: it waits for the decision and
prints it on stdout as one JSON line (`{"decision": "approve"}` or `{"decision": "deny", "reason":
...}`), exiting 0. Refused, unanswered in time, or with no Marley, it prints nothing on stdout and
exits 1, so the plugin leaves the call to the agent's own dialog.

Since #805, `"$MARLEY_BIN" show [--as KIND] [--title TEXT] FILE|-` asks Marley to show a file, or
stdin for `-`, in a tab beside the terminal: a table, a component tree, markdown or an image, by
`--as`, else by the file's extension (`.json` is a tree when it parses as one, else a table). Stdin
(16 MB at most) is copied to a private file beside the socket first. A missing file, a type it
cannot name, or content Marley refuses (`show_invalid`) prints the reason on stderr and exits 1.
Where no Marley answers, it prints its input unchanged and exits 0, so a script may use it anywhere.
"""

import argparse
import json
import os
import shutil
import socket
import sys
import time

# Within the plugin's budgets: a release must end inside Claude Code's `session.end`, and an
# approve inside the plugin's ten minutes for a decision.
DEADLINES = {"report": 4.0, "release": 0.9, "approve": 570.0, "show": 4.0}

# What `show` shows a file as, by `--as` and by its extension (#805).
SHOW_AS = {"table": "table", "csv": "table", "tsv": "table", "jsonl": "table",
           "component": "component", "markdown": "markdown", "image": "image"}
SHOW_EXTENSIONS = {"csv": "table", "tsv": "table", "psv": "table", "ssv": "table",
                   "jsonl": "table", "md": "markdown", "markdown": "markdown", "png": "image",
                   "jpg": "image", "jpeg": "image", "gif": "image", "svg": "image",
                   "webp": "image", "bmp": "image", "json": "json"}
SHOW_STDIN_LIMIT = 16 * 1024 * 1024


def quota_window(text):
    parts = text.split(":")
    if len(parts) not in (2, 3) or not parts[0]:
        raise argparse.ArgumentTypeError("a quota is KIND:PERCENT_USED[:RESETS_AT_MS]")
    try:
        used = int(parts[1])
    except ValueError:
        try:
            used = float(parts[1])
        except ValueError:
            raise argparse.ArgumentTypeError("a quota's percent used is a number") from None
    window = {"kind": parts[0], "percent_used": used}
    if len(parts) == 3:
        try:
            window["resets_at_ms"] = int(parts[2])
        except ValueError:
            raise argparse.ArgumentTypeError("a quota's reset is a whole number") from None
    return window


def whole(text):
    value = int(text)
    if value < 0:
        raise argparse.ArgumentTypeError("a whole number, not negative")
    return value


def parser():
    top = argparse.ArgumentParser(prog="marley-agent")
    top.add_argument("--request-id")
    verbs = top.add_subparsers(dest="verb", required=True)
    report = verbs.add_parser("report")
    report.add_argument("--source", required=True)
    report.add_argument("--seq", type=whole, required=True)
    report.add_argument("state", metavar="STATE")
    report.add_argument("--prompt")
    report.add_argument("--option", action="append", default=[])
    report.add_argument("--percent", type=whole)
    report.add_argument("--activity")
    report.add_argument("--session-id")
    report.add_argument("--resume-arg", action="append", default=[])
    report.add_argument("--input-tokens", type=whole)
    report.add_argument("--output-tokens", type=whole)
    report.add_argument("--cache-read-tokens", type=whole)
    report.add_argument("--quota", type=quota_window, action="append", default=[])
    release = verbs.add_parser("release")
    release.add_argument("--source", required=True)
    approve = verbs.add_parser("approve")
    approve.add_argument("--source", required=True)
    approve.add_argument("--call", required=True)
    approve.add_argument("--tool", required=True)
    show = verbs.add_parser("show")
    show.add_argument("--as", dest="kind", choices=sorted(SHOW_AS))
    show.add_argument("--title")
    show.add_argument("source", metavar="FILE")
    return top


def report_of(args, fail):
    """The report object, as `rh report` builds it from the same arguments."""
    if (args.prompt is None) != (not args.option):
        fail("--prompt and --option come together")
    tokens = [args.input_tokens, args.output_tokens, args.cache_read_tokens]
    if any(count is not None for count in tokens) and None in tokens:
        fail("the three token counts come together")
    if args.percent is not None and args.percent > 255:
        fail("--percent is 0 to 255")
    report = {"source": args.source, "seq": args.seq, "state": args.state}
    if args.prompt is not None:
        report["question"] = {"prompt": args.prompt, "options": args.option}
    if args.percent is not None or args.activity is not None:
        progress = {}
        if args.percent is not None:
            progress["percent"] = args.percent
        if args.activity is not None:
            progress["activity"] = args.activity
        report["progress"] = progress
    if args.session_id is not None:
        report["session_id"] = args.session_id
    if args.resume_arg:
        report["resume_argv"] = args.resume_arg
    if args.input_tokens is not None:
        report["usage"] = {"input_tokens": args.input_tokens,
                           "output_tokens": args.output_tokens,
                           "cache_read_tokens": args.cache_read_tokens}
    if args.quota:
        report["quota"] = args.quota
    return report


def socket_path():
    here = os.path.dirname(os.path.realpath(__file__))
    with open(os.path.join(here, "agent-socket"), encoding="utf-8") as file:
        return file.read().strip()


def send(request, deadline):
    """Marley's answer to `request`, or None when no Marley answers in time."""
    try:
        path = socket_path()
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as conn:
            conn.settimeout(max(deadline - time.monotonic(), 0.01))
            conn.connect(path)
            conn.sendall((json.dumps(request) + "\n").encode("utf-8"))
            answer = b""
            while not answer.endswith(b"\n"):
                conn.settimeout(max(deadline - time.monotonic(), 0.01))
                chunk = conn.recv(4096)
                if not chunk:
                    break
                answer += chunk
        return json.loads(answer.decode("utf-8")) if answer.strip() else None
    except (OSError, ValueError):
        return None


def stdin_suffix(kind, named, data):
    """The extension of the stdin copy, which Zed's viewers read the type from."""
    if named in ("csv", "tsv", "jsonl"):
        return "." + named
    if kind == "image":
        for magic, suffix in ((b"\x89PNG", ".png"), (b"\xff\xd8", ".jpg"), (b"GIF8", ".gif")):
            if data.startswith(magic):
                return suffix
        return ".svg" if data.lstrip().startswith((b"<svg", b"<?xml")) else ".png"
    return {"component": ".json", "markdown": ".md"}.get(kind, ".txt")


def show(args):
    """`show` (#805): the file or stdin in a tab beside the terminal, or printed where no Marley
    answers."""
    data = path = None
    if args.source == "-":
        data = sys.stdin.buffer.read(SHOW_STDIN_LIMIT + 1)
        if len(data) > SHOW_STDIN_LIMIT:
            sys.stderr.write("show: stdin is larger than 16 MB\n")
            return 1
    else:
        path = os.path.abspath(args.source)
        if not os.path.isfile(path):
            sys.stderr.write(f"show: {args.source}: no such file\n")
            return 1

    def printed():
        if data is not None:
            sys.stdout.buffer.write(data)
        else:
            with open(path, "rb") as file:
                shutil.copyfileobj(file, sys.stdout.buffer)
        sys.stdout.flush()
        return 0

    if args.kind:
        kind = SHOW_AS[args.kind]
    else:
        kind = SHOW_EXTENSIONS.get(os.path.splitext(path or "")[1].lstrip(".").lower())
    if kind is None:
        sys.stderr.write("show: name the type with --as: table, component, markdown or image\n")
        return 1
    terminal = os.environ.get("MARLEY_TERMINAL_ID", "")
    if not terminal:
        return printed()
    copy = None
    if data is not None:
        try:
            folder = os.path.dirname(socket_path())
            copy = os.path.join(folder, f"show-{os.getpid()}-{time.time_ns()}"
                                + stdin_suffix(kind, args.kind, data))
            descriptor = os.open(copy, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            with os.fdopen(descriptor, "wb") as file:
                file.write(data)
        except OSError:
            return printed()
    request = {"verb": "show", "terminal": terminal, "path": copy or path, "kind": kind,
               "stdin": copy is not None}
    if args.title:
        request["title"] = args.title
    answer = send(request, time.monotonic() + DEADLINES["show"])
    if isinstance(answer, dict) and answer.get("ok") is True:
        return 0
    if copy is not None:
        try:
            os.remove(copy)
        except OSError:
            pass
    if isinstance(answer, dict) and answer.get("refused") == "show_invalid":
        sys.stderr.write(f"show: {answer.get('reason', '')}\n")
        return 1
    return printed()


def main():
    top = parser()
    args = top.parse_args()
    if args.verb == "show":
        return show(args)
    deadline = time.monotonic() + DEADLINES[args.verb]
    terminal = os.environ.get("MARLEY_TERMINAL_ID", "")
    if args.verb == "report":
        request = {"verb": "report", "terminal": terminal,
                   "report": report_of(args, top.error)}
    elif args.verb == "approve":
        try:
            tool_input = json.loads(sys.stdin.read() or "{}")
        except ValueError:
            top.error("the tool's input on stdin is not JSON")
        request = {"verb": "approve", "terminal": terminal, "source": args.source,
                   "call": args.call, "tool": args.tool, "input": tool_input}
    else:
        request = {"verb": "release", "terminal": terminal, "source": args.source}
    answer = send(request, deadline)
    if not isinstance(answer, dict):
        sys.stderr.write("marley_not_running: no Marley answered on its agent socket\n")
        return 1
    if args.verb == "approve" and answer.get("decision") in ("approve", "deny"):
        sys.stdout.write(json.dumps(answer) + "\n")
        return 0
    if answer.get("ok") is True:
        return 0
    sys.stderr.write(f"{answer.get('refused', 'agent_refused')}: {answer.get('reason', '')}\n")
    return 1


if __name__ == "__main__":
    sys.exit(main())
