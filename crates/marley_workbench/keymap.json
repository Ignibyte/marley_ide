// The Marley keymap: keys Zed's own keymaps do not bind, for Marley's actions and for Zed's
// actions in Marley's contexts. It loads after Zed's default keymaps and before the user's
// (`load_keymap`), so a binding here wins over Zed's defaults at the same context depth and loses
// to the user's own.
[
  {
    "context": "Workspace",
    "bindings": {
      "secondary-alt-n": "marley::NewAgent",
      // Undo a working agent's close while Marley holds it (#550). Zed binds the key to Reopen
      // Closed Item in the same context; this one loads later, so it is tried first, and it
      // hands the key back when nothing is held. Wherever the focus lands after the close (an
      // empty pane, the rail), the Workspace context is in its chain.
      "ctrl-shift-t": "marley::UndoCloseTerminal",
      // The rail's Projects and Brain views (#644). Zed's Linux keymap binds no Ctrl-Alt-V; its
      // Ctrl-Alt-B is the right dock and Ctrl-Alt-J the sidebar.
      "secondary-alt-v": "marley::ToggleBrainView",
      // Rusty's page picker (#654). No keymap Zed ships binds Ctrl-Alt-U (TextMate's on macOS is
      // Ctrl, where `secondary` is Cmd). Rusty's own Ctrl-O stays Zed's Open Files and the
      // terminal's program's.
      "secondary-alt-u": "rusty::OpenPage"
    }
  },
  {
    // The block keys, as Warp binds its own; Zed's terminal binds neither key (T1c). Ctrl-G
    // opens the rich input while a CLI agent runs, as Warp's does, and otherwise reaches the
    // program as before (T7e). → takes the autosuggestion, and otherwise reaches the program
    // too (T3a).
    "context": "Terminal",
    "bindings": {
      "secondary-up": "marley::PreviousBlock",
      "secondary-down": "marley::NextBlock",
      "ctrl-g": "marley::RichInput",
      "ctrl-i": "marley::TakeOverTerminal",
      // An agent's command waiting under the terminal (#556): Enter runs it, Escape refuses it;
      // with none waiting, both keys reach the program.
      "enter": "marley::RunAgentCommand",
      "escape": "marley::RefuseAgentCommand",
      // The line typed at the prompt goes to an agent (#557); with a block selected, the deeper
      // context below sends the block instead.
      "ctrl-shift-enter": "marley::AskAgent",
      "right": "marley::AcceptSuggestion",
      // A block's filter (#528), Warp's key on Linux; Zed's Linux keymap leaves it unbound.
      "alt-shift-f": "marley::FilterBlock",
      // Bookmarks (#559), Warp's keys on Linux. Ctrl-Shift-B wins over Zed's outline panel
      // toggle, bound in Workspace, while a terminal holds the focus; the jump keys reach the
      // program in a terminal with no bookmark, and Zed binds them only in Editor.
      "ctrl-shift-b": "marley::ToggleBookmark",
      "alt-up": "marley::PreviousBookmark",
      "alt-down": "marley::NextBookmark"
    }
  },
  {
    // The block filter's fields: Escape closes the panel, before the editor's own Escape.
    "context": "MarleyBlockFilter > Editor",
    "bindings": {
      "escape": "marley::CloseBlockFilter"
    }
  },
  {
    // Save as Workflow's editor (#558): Enter saves, Escape closes it with nothing written.
    "context": "MarleyWorkflowEditor > Editor",
    "bindings": {
      "enter": "marley::SaveWorkflow",
      "escape": "menu::Cancel"
    }
  },
  {
    // A workflow's parameters as it runs: Enter runs it, Escape runs nothing.
    "context": "MarleyWorkflowPrompt > Editor",
    "bindings": {
      "enter": "marley::RunWorkflow",
      "escape": "menu::Cancel"
    }
  },
  {
    // A selected block (#554): the arrows move the selection, Escape ends it, Ctrl-Shift-I types
    // its command at the prompt, and Ctrl-Shift-Enter sends it to an agent (#555), as Warp binds
    // them.
    "context": "Terminal && MarleyBlockSelected",
    "bindings": {
      "up": "marley::PreviousBlock",
      "down": "marley::NextBlock",
      "escape": "marley::ClearBlockSelection",
      "ctrl-shift-i": "marley::ReinputBlock",
      "ctrl-shift-enter": "marley::SendBlockToAgent",
      // Find within the selected block (#559); with none selected, Zed's search of the whole
      // terminal keeps the key.
      "ctrl-shift-f": "marley::FindInBlock"
    }
  },
  {
    // A worktree agent's first prompt (#510): Enter makes the worktree and starts the agent,
    // Shift-Enter adds a line, Escape closes it.
    "context": "MarleyWorktreePrompt > Editor",
    "bindings": {
      "enter": "marley::StartWorktreeAgent",
      "shift-enter": "editor::Newline",
      "escape": "menu::Cancel"
    }
  },
  {
    // A projectless group's name (#600): Enter makes or renames the group, Escape closes it.
    "context": "MarleyGroupName > Editor",
    "bindings": {
      "enter": "marley::MakeGroup",
      "escape": "menu::Cancel"
    }
  },
  {
    // The rich input's editor: Enter sends, Shift-Enter adds a line, Escape keeps the draft.
    // Ctrl-Shift-W closes the terminal it sits in, as in the terminal: Zed's unscoped
    // `workspace::CloseWindow` would otherwise outrank the Terminal binding here (#635).
    "context": "MarleyRichInput > Editor",
    "bindings": {
      "shift-enter": "editor::Newline",
      "escape": "marley::CloseRichInput",
      "ctrl-shift-w": "pane::CloseActiveItem"
    }
  },
  {
    // The shell's prompt editor (#627): Ctrl-C empties it, as at a shell's prompt, and
    // Ctrl-Shift-Enter asks the agent with its line, as at the grid's prompt (#573). → takes the
    // history's suggestion at the end of the line, and moves the cursor anywhere else (#637).
    "context": "MarleyShellInput > Editor",
    "bindings": {
      "ctrl-c": "marley::ClearRichInput",
      "ctrl-shift-enter": "marley::AskAgent",
      "right": "marley::AcceptSuggestion"
    }
  },
  {
    // While the completion menu shows, Enter and Tab take its entry, as Zed binds them (#625).
    "context": "MarleyRichInput > Editor && !showing_completions",
    "bindings": {
      "enter": "marley::SendRichInput",
      "tab": "editor::ShowCompletions"
    }
  },
  {
    // The Browser tab's keys, as Chrome binds its own. While the tab has the focus they win over
    // Zed's workspace bindings for the same keys (Ctrl-R opens a recent project, F5 debugs), and
    // Escape reaches the page, or ends pick mode, instead of Zed's Unfollow.
    "context": "MarleyBrowser",
    "bindings": {
      "escape": null,
      "ctrl-l": "marley::FocusAddressBar",
      "ctrl-t": "marley::NewBrowserTab",
      "alt-left": "marley::BrowserBack",
      "alt-right": "marley::BrowserForward",
      "ctrl-r": "marley::BrowserReload",
      "f5": "marley::BrowserReload",
      "ctrl-shift-c": "marley::PickElement"
    }
  },
  {
    // A brain page's tab (#645): Back and Forward of the tab's own, as the Browser tab binds them.
    "context": "RustyPage",
    "bindings": {
      "alt-left": "rusty::PageBack",
      "alt-right": "rusty::PageForward"
    }
  },
  {
    // The Tasks tab's list (#658), with no row editor open: Space toggles as the git panel's
    // does; F2 renames, Delete and Backspace archive, and Shift-Delete deletes for good after
    // asking, as the project panel's keys do; Alt-Up and Alt-Down move, as the collab panel's
    // channels and the editor's lines move.
    "context": "RustyTaskList && not_editing",
    "bindings": {
      "space": "rusty::ToggleTask",
      "f2": "rusty::RenameTask",
      "delete": "rusty::ArchiveTask",
      "backspace": "rusty::ArchiveTask",
      "shift-delete": "rusty::DeleteTask",
      "alt-up": "rusty::MoveTaskUp",
      "alt-down": "rusty::MoveTaskDown"
    }
  },
  {
    // Ctrl-Shift-C from the tab's own fields too, where Zed's `!Terminal` binding of the key (the
    // collab panel) sits as deep as the field.
    "context": "MarleyBrowser > Editor",
    "bindings": {
      "ctrl-shift-c": "marley::PickElement"
    }
  },
  {
    // A pick's caption: Enter sends the pick to the agent.
    "context": "MarleyPickCaption > Editor",
    "bindings": {
      "enter": "marley::SendPick"
    }
  },
  {
    // The Playwright scripts tray's name field: Enter keeps a new script for this project.
    "context": "MarleyScriptName > Editor",
    "bindings": {
      "enter": "marley::NewPlaywrightScript"
    }
  },
  {
    // Browser Clients (#524): Enter in the name field allows the client, and Escape closes the
    // list from the field too, where the editor's own Escape would keep it open.
    "context": "BrowserClients > Editor",
    "bindings": {
      "enter": "marley::AllowBrowserClient",
      "escape": "menu::Cancel"
    }
  },
  {
    "context": "BrowserClients",
    "bindings": {
      "escape": "menu::Cancel"
    }
  },
  {
    // An annotation's note: Enter keeps the annotation, Escape drops it.
    "context": "MarleyAnnotationNote > Editor",
    "bindings": {
      "enter": "marley::KeepAnnotation",
      "escape": "marley::DropAnnotation"
    }
  },
  {
    // The address bar: Enter goes, Escape gives the page its URL and the focus back.
    "context": "MarleyAddressBar > Editor",
    "bindings": {
      "enter": "marley::GoToAddress",
      "escape": "marley::RestoreAddress"
    }
  },
  {
    // A page's JavaScript dialog: Enter answers OK and Escape Cancel, from the card or from a
    // prompt's field.
    "context": "MarleyBrowserDialog",
    "bindings": {
      "enter": "marley::AnswerDialog",
      "escape": "marley::DismissDialog"
    }
  },
  {
    "context": "MarleyBrowserDialog > Editor",
    "bindings": {
      "enter": "marley::AnswerDialog",
      "escape": "marley::DismissDialog"
    }
  },
  {
    // An agent's click the Browser tab holds (#571): Enter allows and Escape refuses, only while
    // the card has the focus, which only the user gives it.
    "context": "MarleyBrowserPause",
    "bindings": {
      "enter": "marley::AllowPausedClick",
      "escape": "marley::RefusePausedClick"
    }
  },
  {
    // The rail's filter and switcher, as Zed's Threads Sidebar binds its own. The rail's context
    // also reaches the popovers it opens, so `!Picker` leaves the keys out of the add-project
    // picker.
    "context": "MarleyRail && !Picker",
    "use_key_equivalents": true,
    "bindings": {
      "secondary-f": "agents_sidebar::FocusSidebarFilter",
      "ctrl-tab": "agents_sidebar::ToggleThreadSwitcher",
      "ctrl-shift-tab": ["agents_sidebar::ToggleThreadSwitcher", { "select_last": true }]
    }
  }
]
