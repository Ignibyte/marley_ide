#!/usr/bin/env bash
# install-marley [--prefix DIR] [--regress] [--remote-server-only]: build `marley` in the release
# profile and install a copy with a desktop entry, so the menu starts an installed Marley rather
# than the debug binary in the shared target directory, which a `cargo clean` or a failed build
# takes away (TICKET-502).
# With `--regress`, the golden set (script/regress, #517) runs against the new build before
# anything is replaced, and a failure installs nothing. Since 2026-09-29 no test runs unless asked
# (CONSTITUTION §7); `--skip-regress`, the old way to skip it, is still accepted.
#
# Under DIR (default ~/.local) it writes the binary lib/marley/marley, its launcher bin/marley,
# share/applications/marley.desktop and the icon share/icons/hicolor/512x512/apps/marley.png
# (Zed's dev-channel icon until #445 gives Marley its own). Run it again after a pull. Each file is
# replaced by a rename, so a running Marley keeps the file it started from and runs the new build
# from its next start.
#
# The launcher exists for stderr. The `dev` channel installs no crash handler, so a panic goes to
# stderr and nowhere else, and a Marley the menu starts has no terminal to show it. When stderr
# is not a terminal, the launcher appends it to logs/stderr.log beside Marley.log.
#
# The build stays on the `dev` channel (crates/zed/RELEASE_CHANNEL), so the installed and the
# debug builds share ~/.config/marley and ~/.local/share/marley. Since #513 a second Marley on
# the same data directory hands its paths to the one that runs and exits.
#
# Every install also stages Marley's remote server for Linux x86_64 hosts (#445). On the `dev`
# channel Zed's client neither downloads a server nor checks one, so Marley uploads the one staged
# for its commit to a host whose ~/.zed_server lacks it. The server is built from the same tree,
# static (musl) and in its own cargo invocation, so the editor's features stay out of it, then
# stripped and gzipped as script/bundle-linux does, into
# ${XDG_DATA_HOME:-~/.local/share}/marley/remote_servers/dev/linux-x86_64/<commit>.gz, the layout
# of Zed's own download cache. The newest three are kept. `--remote-server-only` stages the server
# and builds or installs nothing else.
set -euo pipefail

usage() {
  echo "usage: script/install-marley [--prefix DIR] [--regress] [--remote-server-only]   (DIR defaults to ~/.local)"
}

prefix=$HOME/.local
regress=0
server_only=0
while (($#)); do
  case $1 in
    --prefix)
      [[ $# -ge 2 ]] || { usage >&2; exit 2; }
      prefix=$2
      shift 2
      ;;
    --regress)
      regress=1
      shift
      ;;
    --skip-regress)
      regress=0
      shift
      ;;
    --remote-server-only)
      server_only=1
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
done
prefix=$(realpath -m -- "$prefix")
# The desktop entry quotes the binary's path in Exec, where these characters would need escapes.
if [[ $prefix == *[\"\`\$\\]* || $prefix == *$'\n'* ]]; then
  echo "install-marley: a prefix with a quote, a backtick, a dollar, a backslash or a newline is not supported: $prefix" >&2
  exit 2
fi

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"
built=${CARGO_TARGET_DIR:-$root/target}/release/marley
bin=$prefix/bin
lib=$prefix/lib/marley
applications=$prefix/share/applications
entry=$applications/marley.desktop

# Builds the remote server and stages it for Marley's commit; prints where it went.
stage_remote_server() {
  local target=x86_64-unknown-linux-musl tool
  for tool in musl-gcc llvm-objcopy gzip; do
    if ! command -v "$tool" >/dev/null; then
      echo "install-marley: the remote server needs $tool (the musl and llvm packages)" >&2
      exit 1
    fi
  done
  if ! rustup target list --installed | grep -qx "$target"; then
    rustup target add "$target"
  fi
  until ! pgrep -x cargo >/dev/null; do sleep 2; done
  echo "==> building the remote server for $target in the release profile"
  CC_x86_64_unknown_linux_musl=musl-gcc \
    cargo --config .cargo/bundle-config.toml build --release --target "$target" -p remote_server

  local commit platform_dir
  commit=$(git rev-parse HEAD)
  platform_dir=${XDG_DATA_HOME:-$HOME/.local/share}/marley/remote_servers/dev/linux-x86_64
  mkdir -p "$platform_dir"
  server_stripped=$platform_dir/.remote_server.$$
  server_packed=$platform_dir/.$commit.gz.$$
  trap 'rm -f "$server_stripped" "$server_packed"' EXIT
  llvm-objcopy --strip-debug --discard-all \
    "${CARGO_TARGET_DIR:-$root/target}/$target/release/remote_server" "$server_stripped"
  gzip --best --stdout "$server_stripped" >"$server_packed"
  mv -f "$server_packed" "$platform_dir/$commit.gz"
  rm -f "$server_stripped"
  # The newest three staged servers are kept; the names are commits, so they hold no spaces.
  find "$platform_dir" -maxdepth 1 -name '*.gz' -printf '%T@ %p\n' | sort -rn | tail -n +4 |
    cut -d' ' -f2- | xargs -r rm -f --
  if [[ -n $(git status --porcelain) ]]; then
    echo "    remote server for linux-x86_64 at ${commit:0:10}, with changes not committed: $platform_dir/$commit.gz"
  else
    echo "    remote server for linux-x86_64 at ${commit:0:10}: $platform_dir/$commit.gz"
  fi
}

# The target directory is shared by every project on the box. `pgrep -x`, since `pgrep -f`
# would match this script's own command line.
until ! pgrep -x cargo >/dev/null; do sleep 2; done

if ((server_only)); then
  stage_remote_server
  exit 0
fi

echo "==> building marley in the release profile"
cargo build --release -p zed --bin marley
stage_remote_server

if ((regress)); then
  echo "==> the golden set against the new build (script/regress, asked for with --regress)"
  if ! E2E_BINARY=$built script/regress; then
    echo "install-marley: the golden set failed against the new build, so nothing was installed" >&2
    exit 1
  fi
else
  echo "==> the golden set not run (--regress runs it)"
fi

echo "==> installing into $prefix"
mkdir -p "$bin" "$lib" "$applications"
staged=$lib/.marley.new.$$
launcher=$bin/.marley.new.$$
trap 'rm -f "$staged" "$launcher"' EXIT
install -m755 "$built" "$staged"
mv -f "$staged" "$lib/marley"
cat >"$launcher" <<EOF
#!/usr/bin/env bash
# Marley's launcher, written by script/install-marley (#502). A panic on the dev channel goes to
# stderr only, so when stderr is not a terminal (a start from the menu) it goes to a log.
if [[ ! -t 2 ]]; then
  logs=\${XDG_DATA_HOME:-\$HOME/.local/share}/marley/logs
  if mkdir -p "\$logs"; then
    # One earlier log is kept once it passes 10 MiB.
    if [[ \$(stat -c %s "\$logs/stderr.log" 2>/dev/null || echo 0) -gt 10485760 ]]; then
      mv -f "\$logs/stderr.log" "\$logs/stderr.log.old"
    fi
    printf '%s marley %s started\\n' "\$(date -Is)" "\$*" >>"\$logs/stderr.log"
    exec 2>>"\$logs/stderr.log"
  fi
fi
exec "$lib/marley" "\$@"
EOF
chmod 755 "$launcher"
mv -f "$launcher" "$bin/marley"
install -Dm644 crates/zed/resources/app-icon-dev.png "$prefix/share/icons/hicolor/512x512/apps/marley.png"
# No MimeType: Marley must not become the handler for text files or folders.
cat >"$entry" <<EOF
[Desktop Entry]
Version=1.0
Type=Application
Name=Marley
GenericName=Text Editor
Comment=Ignibyte's editor: Zed with the block terminal, agents and the browser
TryExec=$bin/marley
Exec="$bin/marley" %U
Icon=marley
Terminal=false
StartupNotify=true
StartupWMClass=com.ignibyte.Marley
Categories=Development;IDE;
Keywords=zed;editor;terminal;agent;browser;
EOF
if command -v update-desktop-database >/dev/null; then
  update-desktop-database "$applications"
fi

commit=$(git rev-parse --short HEAD)
if [[ -n $(git status --porcelain) ]]; then
  echo "    $bin/marley at $commit, with changes not committed"
else
  echo "    $bin/marley at $commit"
fi
echo "    desktop entry: $entry"
running=$(pgrep -x marley | paste -sd ' ' || true)
if [[ -n $running ]]; then
  echo "    Marley is running (pid $running): the new build starts with its next launch."
  echo "    Quit it before starting Marley from the menu; two Marleys on one data directory hang."
fi
case ":$PATH:" in
  *":$bin:"*) ;;
  *) echo "    note: $bin is not on PATH" ;;
esac
