# The golden set (#517): the scenarios `script/regress` runs, and `just install` before it
# installs a build. One scenario per line; `#` starts a comment. Each one checks itself, so a run
# passes or fails with no one reading its shots.
491-marley-mcp.sh                 # the MCP server, the terminal tools, the bridge
484-autosuggestions.sh            # blocks, the prompt at the bottom, suggestions from history
481-rich-input.sh                 # an agent in a terminal, the agent bar, rich input
492-browser-tools.sh              # the Browser tab driven through MCP
500-browser-from-the-rail.sh      # the rail's + opening a Browser tab
515-marley-settings-page.sh       # the Marley settings page, the layout switch
516-secret-redaction-for-agents.sh  # secrets hidden from what agents read
513-one-marley-per-data-dir.sh    # startup: one Marley per data directory
544-blocks-survive-a-rewrap.sh    # blocks across a resize that rewraps the terminal
546-block-reads-under-the-alternate-screen.sh  # block reads while vim or less holds the screen
519-claude-code-events-in-the-rail.sh  # Claude Code's hook events: the hook's bound, frames kept off the desktop
547-claude-code-events-slice-2.sh    # the plugin update, fleet_snapshot's seats, a row with no update
535-phone-push-notifications.sh      # pushes to the phone: only agents' events, only while away, the line alone
550-ask-before-ending-a-working-agent.sh  # a close or a quit asks before ending a working agent; the hold and undo
520-terminal-identity.sh             # each terminal's own id and project; the tools know their caller
574-browser-tools-in-the-callers-project.sh  # a browser call with no tab acts in the caller's project
575-terminal-id-across-restore.sh   # a restored terminal keeps its id; a split and a new one get their own
577-restored-terminal-keeps-its-folder.sh  # a restored terminal opens in the folder it was in
576-browser-tabs-table-item-id-not-unique.sh  # a Browser tab's row survives another workspace's tab of the same item id
549-selection-to-the-agent.sh  # the editor's selection typed at a terminal agent's prompt; the picker, rich input, the refusal
562-orca-redactor-cross-check.sh  # the rules from Orca's redactor: authorization schemes, hyphenated names, cookies
503-terminal-urls-open-in-the-browser.sh  # a terminal's URL: a Browser tab or the system browser, the dev server's offer, ssh
